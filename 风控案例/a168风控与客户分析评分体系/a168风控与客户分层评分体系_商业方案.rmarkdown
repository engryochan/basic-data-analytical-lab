```

::: {.callout-important}
## 标签策略：路径乙确立（E1-01 已裁定）

E1 全局查询证明 `dailyreport_member` 与 `bet02` 时间窗几乎完全重叠，
**采用路径乙：坚守 2026-03-21 ~ 2026-08-06 窗口（取数条件 dt < 2026-08-07）**。

- **主标签** L1a `dailyreport_member.risk`（13,392,720 行，136 天）
- **辅助** L1b `dailyreport_table.risk`（桌台级，阳性 5.0%）
- **一票否决** L0 `alert_ip_setting` 17 个人工确认 IP
- **历史窗可选** L2a `risklist`（2022，注单级人工操作码）——不进入主分析

:::

## 净化切分器 {#sec-purged}

```{r}
#| label: purged
#| echo: false
## ── 时间隔离的两个参数须分列，混为一谈即生死代码 ────────────────────
##   · gap_days（前置空窗）：测试窗**之前**空出的天数。前向推进的净化回测
##     所需者正是此项，本方案承诺 7 日。
##   · embargo_days（后置禁运）：测试窗**之后**、特征已吸收测试期信息的样本。
##     前向推进下训练集恒在测试之前，此项恒空，故仅在双侧取样
##     （allow_future_train=TRUE，如 cpcv_splits）时才有实际作用。
##   代数上：t0 <= t1 < te0 <= te1 ⇒ 「t0 > te1」恒假。故形如
##   `t1[tr] < te0 & !(t0[tr] > te1 & t0[tr] <= te1 + embargo)` 的过滤，
##   其第二项不可达，前置空窗实为 0 日。凭据见 wf_dead_clause_proof()，
##   其剔除样本数恒为 0；本方案回测实取的 purged_folds() 不受此影响
##   （其 te_beg = tr_end + embargo + 1 已在折生成层落实前置空窗）。
purged_wf_splits <- function(panel, t0_col="t0", t1_col="t1",
                             n_splits=6L, gap_days=NULL, embargo_days=NULL,
                             allow_future_train=FALSE){
  t0 <- as.POSIXct(panel[[t0_col]]); t1 <- as.POSIXct(panel[[t1_col]])
  stopifnot(all(t1 >= t0, na.rm=TRUE))
  if (is.null(gap_days)){
    if (!is.null(embargo_days)) gap_days <- embargo_days else {
      ## ★ 空窗由标签实现滞后的经验分布决定，不照抄文献 21 天
      lagd <- as.numeric(difftime(t1,t0,units="days"))
      gap_days <- ceiling(stats::quantile(lagd[is.finite(lagd)],.95,na.rm=TRUE))
      message(glue::glue("前置空窗由经验分布定为 {gap_days} 天（滞后 P95）"))
    }
  }
  if (is.null(embargo_days)) embargo_days <- gap_days
  GAP <- as.difftime(as.numeric(gap_days),     units="days")
  EMB <- as.difftime(as.numeric(embargo_days), units="days")
  ord <- order(t0); n <- length(ord)
  bd <- floor(seq(1, n+1, length.out=n_splits+1L))
  lapply(seq_len(n_splits-1L), function(k){
    tr <- ord[seq_len(bd[k+1L]-1L)]; te <- ord[bd[k+1L]:(bd[k+2L]-1L)]
    te0 <- min(t0[te],na.rm=TRUE); te1 <- max(t1[te],na.rm=TRUE)
    keep <- t1[tr] < te0 - GAP                     # 净化与前置空窗，一式两用
    if (isTRUE(allow_future_train)) keep <- keep | (t0[tr] > te1 + EMB)
    list(fold=k, train=tr[keep], test=te, purge_rate=mean(!keep),
         gap_days=as.numeric(gap_days), embargo_days=as.numeric(embargo_days),
         test_window=c(te0,te1))})
}

## 死代码自证：旧式过滤的后置禁运项在前向推进下剔除样本数应恒为 0，
##   并给出旧式实际留下的前置空窗天数。此函数存在的意义，是让「已斧正」
##   一事留有可复算的凭据，而非口头声明。
wf_dead_clause_proof <- function(panel, t0_col="t0", t1_col="t1",
                                 n_splits=6L, embargo_days=7){
  t0 <- as.POSIXct(panel[[t0_col]]); t1 <- as.POSIXct(panel[[t1_col]])
  EMB <- as.difftime(as.numeric(embargo_days), units="days")
  ord <- order(t0); n <- length(ord)
  bd <- floor(seq(1, n+1, length.out=n_splits+1L))
  killed <- 0L; gaps <- numeric(0)
  for (k in seq_len(n_splits-1L)){
    tr <- ord[seq_len(bd[k+1L]-1L)]; te <- ord[bd[k+1L]:(bd[k+2L]-1L)]
    te0 <- min(t0[te],na.rm=TRUE); te1 <- max(t1[te],na.rm=TRUE)
    c1 <- t1[tr] < te0
    c2 <- !(t0[tr] > te1 & t0[tr] <= te1 + EMB)
    killed <- killed + sum(c1 & !c2, na.rm=TRUE)
    if (any(c1, na.rm=TRUE))
      gaps <- c(gaps, as.numeric(difftime(te0, max(t1[tr][c1], na.rm=TRUE),
                                          units="days")))
  }
  list(killed=killed,
       gap_min=if (length(gaps)) min(gaps) else NA_real_,
       gap_med=if (length(gaps)) stats::median(gaps) else NA_real_)
}

## ★ 此处的 `|` 与后置禁运项**是活的**：CPCV 属双侧取样，训练块可落在测试块
##   之后，故「t0 > te1 + embargo」确有样本命中。前向推进的 purged_wf_splits()
##   不可照搬此式——那正是死代码之由来。
cpcv_splits <- function(panel, N=8L, k=2L, t0_col="t0", t1_col="t1", embargo_days=21){
  t0 <- as.POSIXct(panel[[t0_col]]); t1 <- as.POSIXct(panel[[t1_col]])
  ord <- order(t0); grp <- cut(seq_along(ord), breaks=N, labels=FALSE)
  combos <- utils::combn(N,k,simplify=FALSE)
  message(glue::glue("CPCV: C({N},{k})={length(combos)} 划分，路径数={length(combos)*k/N}"))
  lapply(combos, function(cb){
    te <- ord[grp %in% cb]; tr <- ord[!(grp %in% cb)]
    te0 <- min(t0[te],na.rm=TRUE); te1 <- max(t1[te],na.rm=TRUE)
    keep <- t1[tr] < te0 | t0[tr] > te1 + as.difftime(embargo_days,units="days")
    list(combo=cb, train=tr[keep], test=te, purge_rate=mean(!keep))})
}

## 泄漏断言：不止查「训练是否早于测试」，并查**实测空窗是否达到设定值**——
##   空窗为 0 日照样满足「早于」，故只查先后次序验不出前置空窗缺位。
assert_no_leakage <- function(splits, panel, t0_col="t0", t1_col="t1",
                              min_gap_days=0){
  t0 <- as.POSIXct(panel[[t0_col]]); t1 <- as.POSIXct(panel[[t1_col]])
  gap <- vapply(splits, function(s) if (!length(s$train)) NA_real_ else
    as.numeric(difftime(min(t0[s$test],na.rm=TRUE),
                        max(t1[s$train],na.rm=TRUE), units="days")), numeric(1))
  ok <- is.na(gap) | gap >= min_gap_days
  list(all_pass=all(ok), failed=which(!ok),
       min_gap=suppressWarnings(min(gap, na.rm=TRUE)),
       mean_purge=mean(vapply(splits,`[[`,0,"purge_rate")))
}

## ── 折结构体检：折是否合规，一律以实测表判定，不凭源码推断 ─────────────
##   入参为 purged_folds() 的产出（每折 $tr = c(起,止)、$te = c(起,止)）。
##   显示用列名走字面量向量注入，不经符号表——Windows 中文 locale 下
##   符号表以 native 字节存名，出口即残缺（根因见 @sec-changelog）。
WF_HEALTH_LBL <- c("折次", "训练起", "训练止", "训练日数",
                   "实测空窗（日）", "测试起", "测试止", "测试日数")
wf_fold_health <- function(folds){
  if (!length(folds)) return(NULL)
  out <- do.call(rbind, lapply(folds, function(f) data.frame(
    fold      = f$fold,
    train_lo  = as.character(f$tr[1]),
    train_hi  = as.character(f$tr[2]),
    train_len = as.integer(as.numeric(f$tr[2] - f$tr[1])) + 1L,
    gap        = as.integer(as.numeric(f$te[1] - f$tr[2])) - 1L,
    test_lo   = as.character(f$te[1]),
    test_hi   = as.character(f$te[2]),
    test_len  = as.integer(as.numeric(f$te[2] - f$te[1])) + 1L,
    stringsAsFactors = FALSE)))
  names(out) <- WF_HEALTH_LBL
  out
}

## 折结构三项硬判：空窗恒达设定值、训练长度恒定、测试窗互不重叠。
wf_fold_assert <- function(health, gap_expect = BT_PARAMS$embargo){
  if (is.null(health) || !nrow(health))
    return(c("空窗恒达设定值"=NA, "训练长度恒定"=NA, "测试窗互不重叠"=NA))
  g <- health[[5]]; L <- health[[4]]; lo <- as.Date(health[[6]])
  c("空窗恒达设定值" = all(g >= gap_expect),
    "训练长度恒定"   = (length(unique(L)) == 1L),
    "测试窗互不重叠" = (length(lo) < 2L) || all(diff(lo) > 0))
}
```

## 强制披露

```{r}
#| label: leak
#| echo: false
tibble::tibble(
  协议=c("朴素 5-fold（有泄漏）","Purged Walk-Forward","CPCV 多路径 均值±SD"),
  `PR-AUC`=NA_real_, Lift=NA_real_, `95% CI`=NA_character_,
  说明=c("**仅对照，不得用于结论**","**主口径**","稳健性")) |> aurora_kb(caption="泄漏规模量化（数据到位后填充）")
```

同时必须报告：**各折净化率、有效折数、泄漏断言结果、朴素与净化的差值**。
差值本身是结论的一部分。

## 折规格契约：三套并存，各有其域 {#sec-fold-contract}

本项目并存三套折规格。三者皆合法，但**不可互相冒名**——凡引用折级结果，须同时标明所据何套。

| 规格 | 训练 | 空窗 | 测试 | 步长 | 适用范围 |
|---|---:|---:|---:|---:|---|
| **甲** | 63 日 | 7 日 | 14 日 | **7 日** | 本方案回测（`BT_PARAMS`），@sec-strategy-bt 全部折级结果 |
| **乙** | 63 日 | 7 日 | 14 日 | **14 日** | 精要商业报告的四轨回测 |
| **丙** | 42 日 | 7 日 | 14 日 | **7 日** | 多目标建模阶段（Phase 3）的十一折，属研究阶段，不入任何交付件 |

甲乙之别只在步长，而其统计后果不可忽略：**步长等于测试窗长（乙）则各折测试窗互不重叠、
折级统计量近似独立；步长为其半（甲）则测试窗重叠一半、折间相关**，故甲的区间估计
一律走分块自助，不得用独立重采样。丙的窗长较短，折数因而为十一，与甲乙的折数不可直接比较。

::: {.callout-important}
## 标签侧泄漏：与特征侧泄漏并列而不同

净化滚动所隔离的是**特征**。若训练标签本身由**全窗**证据构成，则折内训练照样看见未来——
此即**标签侧泄漏**，净化与空窗对其一概无效。

本项目的金标准 $\mathrm{TRUTH}$ ＝ 全窗完全反向对打成员 ∪ 人工风险单。
前者由本窗口内的下注行为算出、**带有时点**，后者为外部登记。
凡以 $\mathrm{TRUTH}$ 作**折内训练标签**者（精要报告的模型轨即是），
若某会员的完全反向行为发生在该折测试窗内，其 $y=1$ 仍入该折训练。

**波及与不波及，须分清**：受影响者为以该标签训练所得的模型轨指标（净增益、
金标准命中率、Lift、基率分母），一律记为**上界**；不受影响者为不取 $\mathrm{TRUTH}$ 为
判据的能力值轨与规则轨，以及罚侧的确定性证据链——后者系**事后取证**，非预测，
其正当性不依赖时序隔离。

**斧正路径**：折内金标准
$\mathrm{TRUTH}_{tr}(f)=\{m:\text{首次完全反向日}<\text{该折训练窗末日}\}\cup\{\text{登记日早于训练窗末日的人工风险单}\}$。

- **所待文件**：`C06d_hedge_pairs_dated.csv`（SQL 总包 **§C06d**，与 §C06fix 同式同过滤，
  多出 `first_opposite_dt` / `last_opposite_dt` / `n_opposite_days` 三列）
- **受影响输出**：精要商业报告「回测并评估」一章中模型轨的四项折级指标与基率分母
- **同表另须产出者**：仅由测试窗证据而入选者占 $\mathrm{TRUTH}$ 之比——此数即泄漏幅度的直接度量
:::

::: {.callout-warning}
## 目标派生特征污染：嫌疑成立，须以消融检验定夺

模型轨的特征含 `hedge`（会员日级对打率），而标签 $\mathrm{TRUTH}$ 的主要来源是
对级的「完全反向」判定。二者非同一量，却由同一批下注行为算出——
凡 $\mathit{opposite\_rate}=1$ 之成员，其对打率必高。故模型在该特征上的判别力
**有相当部分是构造上的同义反复**，而非独立发现。

此为嫌疑，非定论。定夺之法是**消融检验**：剔除对打族特征（`hedge`，必要时并剔 `nip`）
后重跑模型轨，若折均净增益与 Lift 大幅塌陷，即证其判别力主要来自与标签同源的特征。
所待：一次不含对打族特征的模型轨回测；受影响输出：模型轨的可信度评级。
在其完成之前，模型轨**不得单独作为「模型优于规则」的凭据**。
:::

## 折结构体检 {#sec-wf-health}

折是否合规，以**实测表**判定，不以源码推断。本方案回测所取的折由 `purged_folds()`
按日期算术生成——训练窗末日之后空出 `embargo` 日，测试窗方始（`te_beg = tr_end + embargo + 1`），
故前置空窗落实在折生成层，而非事后过滤。体检逐折列出训练区间、训练日数、**实测空窗**、
测试区间与测试日数，并作三项硬判：空窗恒达设定值、训练长度恒定、测试窗互不重叠。

同表另附**死代码自证**：按前向推进的代数，形如「训练结束早于测试开始」再叠加
「训练开始晚于测试结束」的过滤，其第二项恒假。自证给出该项实际剔除的样本数——
此数若非零，即前向推进的前提不成立，须回查折生成；若为零，则该写法在前向推进下
不产生任何隔离效果，前置空窗只能由折生成层提供。

```{r}
#| label: wf-health
#| echo: false
## 折体检只需**营业日**，不需整张面板——面板逾千万行，取 unique 后仅百余日，
## 死代码自证亦在此百余点观测上复算，内存开销可忽略。
## 取用释放前留存的营业日向量，不回头取已 release() 的大表
WF_U  <- if (exists("WF_DAYS")) WF_DAYS else as.Date(character(0))
WF_OK <- length(WF_U) > 0
WF_FH <- if (length(WF_U)) wf_fold_health(purged_folds(WF_U)) else NULL
if (!is.null(WF_FH)) {
  aurora_kb(WF_FH, caption = paste0(
    "折结构体检（训练 ", BT_PARAMS$train, " 日 · 空窗 ", BT_PARAMS$embargo,
    " 日 · 测试 ", BT_PARAMS$test, " 日 · 步长 ", BT_PARAMS$step,
    " 日 · ", BT_PARAMS$mode,
    "）｜解释：实测空窗＝测试首日与训练末日之间实际空出的天数",
    "｜本方案用途：空窗为零日即训练与测试首尾相接，跨窗结算与延迟信息会互相污染"))
} else if (WF_OK) {
  aurora_kb(tibble::tibble(
    状态 = "⬜ 时间跨度不足，切不出完整折",
    面板营业日数 = length(WF_U),
    最短所需 = BT_PARAMS$train + BT_PARAMS$embargo + BT_PARAMS$test),
    caption = "折结构体检")
} else {
  aurora_kb(tibble::tibble(
    状态 = "⬜ 待数据（非错误）",
    本节内容 = "折结构体检",
    所待文件 = "B01_bt_panel.csv（SQL 总包 §B01）——其营业日向量于释放前留存为 WF_DAYS",
    契约必需列 = "bet_date",
    受影响输出 = "折结构体检表、折结构硬判与死代码自证表"),
    caption = "折结构体检")
}
```

```{r}
#| label: wf-health-assert
#| echo: false
if (!is.null(WF_FH)) {
  WF_AS <- wf_fold_assert(WF_FH, gap_expect = BT_PARAMS$embargo)
  ## 死代码自证：以点观测（t0 = t1 = 营业日）复算旧式过滤的后置禁运项剔除量
  WF_PF <- wf_dead_clause_proof(data.frame(t0 = WF_U, t1 = WF_U),
                                n_splits = max(3L, nrow(WF_FH)),
                                embargo_days = BT_PARAMS$embargo)
  aurora_kb(tibble::tibble(
    判项 = c("空窗恒达设定值", "训练长度恒定", "测试窗互不重叠",
             "旧式后置禁运项剔除样本数", "旧式实际留下的前置空窗（日）"),
    结果 = c(ifelse(WF_AS[1], "✅ 通过", "❌ 未通过"),
             ifelse(WF_AS[2], "✅ 通过", "❌ 未通过"),
             ifelse(WF_AS[3], "✅ 通过", "❌ 未通过"),
             format(WF_PF$killed, big.mark = ","),
             ifelse(is.finite(WF_PF$gap_med), sprintf("%.0f", WF_PF$gap_med), "—")),
    读法 = c(paste0("实测空窗须恒 ≥ ", BT_PARAMS$embargo, " 日"),
             paste0("滑动定长，恒为 ", BT_PARAMS$train, " 日"),
             "测试窗起点须严格递增",
             "为零即证该项在前向推进下不可达",
             "为零即证旧式过滤本身不提供任何前置空窗")),
    caption = "折结构硬判与死代码自证")
} else {
  aurora_kb(tibble::tibble(
    状态 = "⬜ 待数据（非错误）",
    本节内容 = "折结构硬判与死代码自证",
    所待文件 = "B01_bt_panel.csv（SQL 总包 §B01）",
    契约必需列 = "bet_date",
    受影响输出 = "折结构硬判与死代码自证表"),
    caption = "折结构硬判与死代码自证")
}
```

## 泄漏矩阵：逐环判定，只认四种结论 {#sec-leak-matrix}

数据到标签到折到处置，中间每一环都可能漏进未来信息。本节把整条链逐环列出，
每环只给四种结论之一——**通过 / 不通过 / 未证 / 受阻**。「未证」是尚无实测，
「受阻」是数据资产本身不存在、非本方案所能自解，两者性质不同，不可混为一谈。

```{r}
#| label: leak-matrix
#| echo: false
tibble::tribble(
  ~环节, ~须证明什么, ~现有凭据, ~判定, ~解阻所需,
  "① 取数窗口","事实表自身无越界记录","§TG-05 越界自检返回 0 行","✅ 通过","—",
  "② 修订滞后","静态快照与逐日下载信息集等价",
    "§PIT-01：99.99359% 注单 1 小时内定稿，>7 天修订仅 0.00089%","✅ 通过","—",
  "③ 折结构 · 前置空窗","训练窗末日与测试窗首日之间确有 7 日空窗",
    "折生成层 te_beg = tr_end + embargo + 1；@sec-wf-health 逐折实测空窗","✅ 通过","—",
  "④ 折结构 · 训练定长","滑动窗长度恒定，非逐折扩张",
    "sliding 模式；折体检「训练长度恒定」判项","✅ 通过","—",
  "⑤ 折规格唯一性","凡引用折级结果者，所据规格明确且不互相冒名",
    "@sec-fold-contract 三套并列各标其域；精要报告的错误等同声明已更正","✅ 通过","—",
  "⑥ 特征侧时序","每折特征只由该折训练窗聚合而来",
    "回测块内聚合表全部由训练窗切片而来，逐行可核","✅ 通过","—",
  "⑦ 标签侧时序（金标准）","折内训练标签不含测试窗才出现的证据",
    "金标准由**全窗**完全反向对打构成，折内直接取用","❌ **不通过**",
    "§C06d 的首次完全反向日；据以构造折内金标准并重算模型轨",
  "⑧ 标签侧时序（人工单）","人工风险单的登记日早于该折训练窗末日",
    "登记时点已在 §K01b 产出，但折内未据以过滤","⚠️ 未证","以 §K01b 登记日构造折内过滤并重算",
  "⑨ 同期标签","风险单可否作当日特征预测当日标记之用",
    "§P0C-04 + §P0C-09：人内配对 2.37 / 2.51 倍，p < 0.0001","❌ **不通过（已禁用）**",
    "改走标签乙（§P0C-06 骨架）；本方案已不以其训练判别模型",
  "⑩ 目标派生特征","特征与标签非由同一构造派生",
    "对打率与完全反向比例同源，凡完全反向者对打率必高","⚠️ 未证（嫌疑成立）",
    "消融检验：剔对打族特征后重跑模型轨，看折均净增益与 Lift 是否塌陷",
  "⑪ 阈值选择","罚阈值只由训练窗内信息选出",
    "嵌套时序验证：训练窗内前 49 日选人、后 14 日结账定档","✅ 通过","—",
  "⑫ 经济参数","回收率、流失系数、γ* 未由全样本结果反向选择",
    "见下节参数时序归属逐项登记","✅ 通过（惟三者为外生假设，非估计值）","—",
  "⑬ 处置执行","名单上的动作确曾执行","平台**无处置日志**（§EX-01 实测）","⛔ **受阻**",
    "建处置台账（见下节契约），非本方案所能自解",
  "⑭ 反事实对照","有同风险层的随机对照组","无","⛔ **受阻**","玩家级随机灰度，须平台配合",
  "⑮ 增量净收","增量净收由实际处置与对照实测得出","现为情景会计，非实测","⛔ **受阻**","⑬⑭ 到位后方可闭合"
) |> aurora_kb(caption = paste0(
  "泄漏矩阵｜解释：通过＝已有实测凭据；不通过＝已实测出问题；",
  "未证＝尚无实测；受阻＝数据资产不存在，非本方案所能自解",
  "｜本方案用途：对外结论只能引用「通过」环所支撑者，凡跨越未通过环的结论一律标注上界"))
```

**读法**：十五环中八环通过、两环不通过、两环未证、三环受阻。
**不通过与受阻是两回事**：不通过者本方案自己能修（⑦已备 §C06d、⑨已改走标签乙），
受阻者则须平台先建数据资产，文档层面再用功也无从闭合。
故本方案的诚实位置是：**风控体系可用，增利承诺不成立**——后者卡在⑬⑭⑮三环。

## 参数时序归属：每个常数从哪来、能否看见测试窗 {#sec-param-lineage}

外部复核问：回收率、流失系数、γ*、阈值档位、赏池罚池，是否有任一项由全样本结果反向选出。
逐项登记如下。凡「可见范围」写着全窗者，须另看「是否由结果反选」一列——
**全窗可见不等于泄漏，由结果反选才是**。

```{r}
#| label: param-lineage
#| echo: false
tibble::tribble(
  ~参数, ~取值, ~性质, ~可见范围, ~是否由结果反选, ~判定,
  "回收率","0.60","**外生情景参数**，业务给定","不适用（不由数据估）","否","✅ 通过（惟须正名为假设）",
  "流失系数","0.15","**外生情景参数**，业务给定","不适用","否","✅ 通过（同上）",
  "庄家毛利率 m","1.918%","全窗实测常数","全窗","否——由全体流水算出，与名单无关","✅ 通过",
  "退水率 ρ","0.349%","全窗实测常数（agent_dtl.ag003）","全窗","否","✅ 通过",
  "占成率 κ","1.660%","全窗实测常数（agent_dtl.ag012）","全窗","否","✅ 通过",
  "γ* = m − ρ − κ","−0.091%","由上三者算出","全窗","否","✅ 通过",
  "净贡献门槛 2.59%","ρ/(1−κ_share)","由上述常数算出","全窗","否","✅ 通过",
  "罚阈值档位","P99.5 ~ P99.99 逐折现选","**折内嵌套时序选出**：训练窗前 49 日选人、后 14 日结账定档",
    "仅训练窗","否","✅ 通过",
  "赏池档位","P90 ~ P99 逐折现选","同上，以净养账最大化为准则","仅训练窗","否","✅ 通过",
  "误伤上限","按动作层现算","由 g / c / H 三系数导出（@sec-fp-tier）","不适用","否","✅ 通过（三系数为外生假设）",
  "分位归一的分位点","经验分位函数","**只在训练窗上拟合**，再原样套到测试窗","仅训练窗","否","✅ 通过",
  "金标准","全窗完全反向 ∪ 人工单","**全窗证据**","全窗","否（非反选），但**含测试窗证据**",
    "❌ 不通过——见泄漏矩阵⑦"
) |> aurora_kb(caption = paste0(
  "参数时序归属｜解释：可见范围问该参数由哪段数据算出，",
  "是否由结果反选问它有没有拿测试期成绩去挑",
  "｜本方案用途：全窗可见的常数未必泄漏，由结果反选才是——两者须分开判"))
```

**须澄清一处易混**：$m$、$\rho$、$\kappa$、$\gamma^{*}$ 皆由**全窗**算出，
但它们是**经营场所的结构常数**，与名单、阈值、模型无涉，其取值不因回测成绩而变，
故不构成选择泄漏。真正须警惕的是「拿测试期成绩去挑参数」——此项逐条核过，
现存参数中**无一如此**；唯一不通过者是金标准的时序，性质属标签侧泄漏而非参数反选。

## 处置台账：闭合⑬⑭⑮三环所须的数据契约 {#sec-treatment-ledger}

泄漏矩阵末三环之所以受阻，不是尚未开发，而是**产生这些证据所需的数据资产不存在**。
本节给出其最小契约，作为向平台方提出的数据请求——**在其建成之前，
任何增量净收的数字都只能是情景会计，本方案不作例外**。

```{r}
#| label: treatment-ledger
#| echo: false
tibble::tribble(
  ~层, ~表, ~最小字段, ~粒度, ~闭合了哪一环,
  "一 · 风险账","risk_ledger",
    "player_id · score_date · risk_score · risk_grade · risk_type · evidence_ref · model_version",
    "会员 × 评分日","记录当时判了什么，使评分可追溯、可复现",
  "二 · 处置账","treatment_ledger",
    "treatment_id · player_id · action_type · action_time · pre_rebate · post_rebate · pre_limit · post_limit · operator_id · review_status · experiment_id · arm",
    "会员 × 处置事件","⑬ 处置执行——**当前完全缺失，此为最要紧的一张**",
  "三 · 结果账","outcome_ledger",
    "player_id · date · turnover · ggr · ngr · rebate · commission · promo_cost · active · complaint · recovery",
    "会员 × 日","⑮ 增量净收的被解释量",
  "四 · 因果账","causal_ledger",
    "experiment_id · arm · pre_period · post_period · delta_turnover · delta_ggr · delta_ngr · delta_churn",
    "实验 × 组 × 期","⑭ 反事实对照"
) |> aurora_kb(caption = paste0(
  "处置台账最小契约｜解释：四层账各答一问——判了什么、做了什么、结果如何、与对照差多少",
  "｜本方案用途：此四表齐备之前，增量净收与投入产出比一律不得作为已实现收益对外陈述"))
```

::: {.callout-important}
## 三条纪律，先于建表而立

**其一，组别（`arm`）必须在处置发生之前写入，不得事后补填。**
事后补填的对照组不是对照组，是筛选结果；此为整条因果链最易被无声破坏之处。

**其二，处置账与风险账须以 `model_version` 相连。**
否则日后模型一改，旧处置的归因即无从追溯，历史数据随之作废。

**其三，未执行也须记一行。** 名单上而未被处置者，是天然的对照；
只记做过的而不记决定不做的，样本即有选择偏差。
:::


## 评估口径

| 指标 | 地位 | 理由 |
|---|---|---|
| **PR-AUC** | 主口径 | 极不平衡下 ROC-AUC 无信息量 |
| **Lift** | 主口径 | 弱标签下唯一可辩护的表述 |
| Brier / ECE | 校准 | 必须出校准曲线 |
| Wilson CI | 必备 | 所有胜率附 CI |
| Bootstrap CI | 必备 | 所有点估计附 CI |
| DeLong | 显著性 | 模型间 AUC 差异 |
| **Accuracy** | ⛔ 禁用 | 无信息量 |

## 跨月持续性 {#sec-persist}

| 检验 | 判读 |
|---|---|
| 连续月命中率 | ≥ 0.5 视为稳定 |
| Cochran's Q（多月一致性） | p 大 → 各月表现一致 |
| 月度胜率方差齐性（Levene） | 不齐 → 表现不稳定，阈值不可靠 |
| 盈利月数二项检验 | 显著多于随机 → 非偶然盈利 |

---

# 业绩提升的因果验证 {#sec-uplift}

::: {.callout-important}
**判别力高 ≠ 业绩提升。** PR-AUC 0.9 的模型若命中的全是本就不赚钱的小客，
业绩提升为零。必须做**独立于判别力的经济价值验证**。
:::

## 五个分项

| 来源 | 代码 | 机制 | 量化 | 性质与可验证性 |
|---|---|---|---|---|
| 拦截套利敞口 | G1 | 识别 R0/R1/R2 后限制 | Σ(命中者 T+1 期 `game_pnl>0` 部分) × **拦截率（情景参数）** | ⚠ **情景会计**，非严格反事实——须处置执行后以历史单重估 |
| 返水成本优化 | G2 | 识别 R3 后调整档位 | **省下的返水 − 因降档流失的流水 × 毛利率** | ★★ 直接可算，但**须扣流水流失**方为净额 |
| 高价值客留存 | G3 | V1/V2 精准运营 | Δ留存率 × CLV | ★☆ 需 A/B；**下界记 0** |
| 误杀损失 | L1 | V1/V2 被误判流失 | 误判数 × 中位净贡献 × **流失系数（情景参数）** | ★★ 需影子期 |
| 复核人力 | L2 | 人工成本 | 命中数 × 工时 × 时薪 | ★★★ 直接可算 |

$$\Delta \text{GGR} = G_1 + G_2 + G_3 - L_1 - L_2$$

::: {.callout-warning}
## G1 是**情景会计**，不是严格的反事实

`G1 = Σ(命中者赢走额) × 拦截率` 这一式，隐含了「命中即能按该比例止损或追回」的假设。
现实中命中者可能：限红后继续投注、转换产品、流失他往、提出申诉，
或本就只是随机赢钱而非套利。故 **`拦截率` 与 `流失系数` 均属情景参数
（Scenario Parameters），非模型估计值（Expected Economic Effect）**。

本方案自此不再以单点参数报告 ΔGGR，一律改以**情景网格**呈现：
拦截率／回收率 ∈ {0.25, 0.40, 0.60, 0.75}，流失系数 ∈ {0.05, 0.10, 0.15, 0.25}，
逐格给出 ΔGGR、分块自助法区间与 **P(ΔGGR > 0)**（见下方「情景敏感性曲面」）。
真实参数值须由历史处置单重估，并经灰度对照实验确认。
:::

## 反事实回测

```{r}
#| label: counterfactual
#| echo: false
## ★ 反事实回测（2026-08-09 斧正）：三处修正
##   ① `intercept_rate` 与 `churn_rate` 正名为**情景参数**，默认值只是网格中心点，
##      不得当作模型估计；折级明细同时留下 W（命中者赢走额）与 L（命中者输掉额）
##      两个**原值**，供下游在参数网格上重算，无须重跑回测。
##   ② G2 由「省下的返水」改为**净额 = 省下的返水 − 因降档流失的流水 × 毛利率**；
##      流水弹性 `handle_elasticity` 亦为情景参数，未实测前默认 0（即退回旧口径），
##      但一律在输出中显式列出 LostGGR 一列，使高估无从隐藏。
##   ③ 折级输出增列 `W_hit` / `L_hit` / `mis_rate`，使敏感性曲面可由本表直接派生。
counterfactual_backtest <- function(panel, splits, rule_fn,
                                    intercept_rate = 0.5,   # 情景参数：拦截／回收率
                                    churn_rate     = 1.0,   # 情景参数：误伤流失系数
                                    rebate_cut     = 1.0,   # 情景参数：返水调降幅度
                                    handle_elasticity = 0,  # 情景参数：降档→流水流失弹性
                                    margin_rate    = NA_real_){ # 毛利率 m，未给则由面板算
  purrr::map_dfr(splits, function(s){
    tr <- panel[s$train,]; te <- panel[s$test,]
    thr <- rule_fn$calibrate(tr)          # ★ 阈值仅用训练期标定 → 无前视
    hit <- rule_fn$apply(te, thr)         #   应用到测试期
    ## ── 原值（不含任何情景参数），供敏感性曲面重算 ──
    W_hit <- sum(pmax(te$game_pnl[hit], 0), na.rm = TRUE)   # 命中者赢走额
    L_hit <- sum(pmax(-te$net_pnl[hit & te$is_high_value], 0), na.rm = TRUE)
    R_hit <- sum(te$rebate[hit & te$is_rebate_arb], na.rm = TRUE)
    m_hat <- if (is.finite(margin_rate)) margin_rate else {
      vb <- sum(te$valid_bet, na.rm = TRUE)
      if (isTRUE(vb > 0)) -sum(te$net_pnl, na.rm = TRUE) / vb else NA_real_ }
    ## ── 情景值 ──
    G1 <- W_hit * intercept_rate
    saved_rebate <- R_hit * rebate_cut
    lost_ggr <- if (is.finite(m_hat))
      saved_rebate * handle_elasticity * m_hat else 0    # 降档导致的流水流失×毛利
    G2 <- saved_rebate - lost_ggr                        # ★ 净额，不再只记省下的返水
    L1 <- L_hit * churn_rate
    L2 <- sum(hit) * rule_fn$review_cost
    tibble::tibble(fold = s$fold, n_hit = sum(hit),
                   W_hit = W_hit, L_hit = L_hit, R_hit = R_hit, m_hat = m_hat,
                   G1 = G1, G2 = G2, SavedRebate = saved_rebate, LostGGR = lost_ggr,
                   L1 = L1, L2 = L2,
                   delta_ggr = G1 + G2 - L1 - L2, purge_rate = s$purge_rate)})
}

## ★ 区间估计（2026-08-09 斧正）：iid 自助法 → **moving-block 自助法**
##   折级序列存在自相关与季节性（同一客群跨折延续、活动季集中），
##   普通 iid 重抽样低估方差、令区间偏窄（Künsch 1989）。
##   改按相邻折成块重抽样，块长取 ⌈√折数⌉；折数过少时退化为整体均值。
blk_boot <- function(v, R = 2000, seed = 7){
  v <- v[is.finite(v)]; n <- length(v)
  if (n < 2) return(rep(mean(v), R))
  l <- max(1, ceiling(sqrt(n))); k <- ceiling(n / l)
  set.seed(seed)
  replicate(R, {
    st <- sample.int(n - l + 1, k, replace = TRUE)
    mean(unlist(lapply(st, function(i) v[i:(i + l - 1)]))[seq_len(n)])
  })
}
uplift_ci <- function(bt, R = 2000, conf = .95){
  b  <- blk_boot(bt$delta_ggr, R = R)
  a  <- (1 - conf) / 2
  ci <- stats::quantile(b, c(a, 1 - a), na.rm = TRUE)
  tibble::tibble(点估计 = mean(bt$delta_ggr),
    CI下界 = ci[[1]], CI上界 = ci[[2]],
    区间口径 = sprintf("moving-block 自助法（块长 %d，R=%d）",
                    max(1, ceiling(sqrt(sum(is.finite(bt$delta_ggr))))), R),
    结论 = ifelse(ci[[1]] > 0, "✅ 证实业绩提升", "⛔ **未能证实**"))
}

## ★ 情景敏感性曲面（2026-08-09 新增）：拦截／回收率 × 流失系数 4×4 网格。
##   直接由回测折级的**原值**（W_hit / L_hit / R_hit）重算，无须重跑回测。
##   每格给出 ΔGGR、moving-block 90% 区间与 P(ΔGGR>0)。
##   ★ 判定纪律不变：区间跨 0 即该情景下「未能证实」，不得软化表述。
profit_sensitivity <- function(bt,
    recovery = c(.25, .40, .60, .75),
    churn    = c(.05, .10, .15, .25),
    rebate_cut = 1.0, handle_elasticity = 0, R = 1000){
  stopifnot(all(c("W_hit","L_hit") %in% names(bt)))
  R_hit <- if ("R_hit" %in% names(bt)) bt$R_hit else 0
  m_hat <- if ("m_hat" %in% names(bt)) bt$m_hat else NA_real_
  saved <- R_hit * rebate_cut
  lost  <- ifelse(is.finite(m_hat), saved * handle_elasticity * m_hat, 0)
  L2    <- if ("L2" %in% names(bt)) bt$L2 else 0
  purrr::map_dfr(recovery, function(rr)
    purrr::map_dfr(churn, function(cc){
      g <- rr * bt$W_hit + (saved - lost) - cc * bt$L_hit - L2
      b <- blk_boot(g, R = R, seed = 17)
      tibble::tibble(`回收率` = rr, `流失系数` = cc,
        `ΔGGR` = mean(g),
        `下界` = stats::quantile(b, .05, na.rm = TRUE)[[1]],
        `上界` = stats::quantile(b, .95, na.rm = TRUE)[[1]],
        `P(ΔGGR>0)` = mean(b > 0),
        `判定` = ifelse(stats::quantile(b, .05, na.rm = TRUE)[[1]] > 0,
                      "✅ 该情景下证实", "⛔ 未能证实"))}))
}
```

::: {.callout-warning}
## 判定规则（不可放宽）

**仅当 `ΔGGR` 的 Bootstrap 95% CI 下界 > 0 时，才可声称「证实业绩提升」。**

点估计为正但 CI 跨 0 → 结论是 **「未能证实」**，
不得改述为「初步显示正向」之类的软化表达。

**且必须做安慰剂检验**：随机命中同等数量会员跑同一流程，
若安慰剂 ΔGGR 也显著为正，说明增益来自「命中大客」而非「命中风险客」，
整套结论作废。

**新增两条（2026-08-09）**：

**其一，不得以单点参数报告业绩。** 一切 ΔGGR 须以情景曲面呈现
（`profit_sensitivity()`），并同时给出 `P(ΔGGR>0)`。**若曲面中存在业务认可参数区间内
符号翻转的格位，即不得对外宣称增利**——须在结论中明列翻转的分界线。

**其二，区间一律用 moving-block 自助法。** 折级序列自相关下，iid 重抽样的区间偏窄，
据此宣称「CI 下界 > 0」不成立。折数少于两位数时，`P(ΔGGR>0)` 只作方向参考，
不得作为统计确定性对外表述。
:::

## 情景敏感性曲面

```{r}
#| label: sensitivity-surface
#| echo: false
#| eval: false
## 用法（回测跑完后执行）：
##   surf <- profit_sensitivity(bt)                 # 4×4 网格
##   knitr::kable(surf, digits = 3)
## 读法：只看自己认可的那一格，并看区间是否跨 0；跨 0 即该情景下未能证实增利。
## 真实参数须由历史处置单重估：
##   回收率 = 实际追回额 ÷ 标记不当得利额（按月滚动）
##   流失系数 = 误伤复核后该客流水衰减 × 毛利率
##   流水弹性 = 返水降档后该客流水变动率（须有档位变更史）
```

::: {.callout-note}
## 参数正名：Scenario Parameters，非 Expected Economic Effect

`拦截率／回收率 0.50~0.60`、`流失系数 0.15`、`返水调降幅度`、`流水弹性`
四者一律为**情景参数**。它们不是本方案估计所得，亦不构成对业绩的预期。
在以历史处置单重估之前，任何据此外推的年化金额，只能表述为
「在该组假设下的潜在增利区间」，不得表述为「预计增加」。
:::

## 多重检验修正

阈值网格会产生数十至数百组候选，从中挑最优必然向上偏。

| 方法 | 用途 |
|---|---|
| CPCV 多路径分布 | 用路径间方差估计「最优值的偏乐观程度」 |
| Deflated 思想 | 依试验次数与路径方差，对最优 ΔGGR 折减 |
| **时间外保留窗 OOT** | **最后一段时间完全不参与标定与选择**，仅用于终检 |

**OOT 是最后一道闸。** 若 OOT 上 ΔGGR 显著低于净化 CV 估计，
说明选择偏差严重，推荐阈值须回退至更保守档。

---

# 试运行阈值推荐 {#sec-recommend}

::: {.callout-important}
需求 §7 末条：**无确认风险标签时，只能定义为「试运行阈值」。**
以下全部标注 **Trial**，并提供宽松/严格双档以满足原则 ⑦。
:::

```{r}
#| label: recommend
#| echo: false
tibble::tribble(
  ~规则, ~档位, ~条件, ~状态,
  "异常IP","Trial-L","最小关联玩家数≥[§4.4定] ∧ 该IP最小订单数≥[定] ∧ 盈利玩家比例(版本C)≥[定]","待数据",
  "异常IP","Trial-S","同上，各参数提高一档","待数据",
  "尾段下注","Trial-L","**按桌台**进度分位≥[定] ∧ 尾段局数≥[定] ∧ 占比≥[定] ∧ 胜率差≥[定]","待数据",
  "尾段下注","Trial-S","同上，各参数提高一档","待数据",
  "强特征","独立","尾段游戏盈利>0 ∧ 正常时段游戏盈利≤0 ∧ 尾段局数≥[定]","待数据",
  "组合","最高优先","同一异常IP下尾段风险玩家数≥[§6定] ∧ 同步时间差中位<[定]秒","待数据"
) |> aurora_kb(caption="试运行阈值推荐框架")
```

## 为什么不选更宽松/更严格（需求 §1 明文要求）

每档必须回答三问，格式固定：

```
【选择 X 的理由】
  分布位置：X 处于 P__，明显高于普通用户
  样本充分性：命中者尾段局数 P50 = __，Wilson CI 宽度 = __
  审核可行性：每30天命中 __ 个（分母 __ 万会员，命中率 __%），在团队产能内
  跨月稳定：连续2月重复命中率 __
  L0 检验：17 个人工确认 IP 命中 __ 个

【不选更宽松（X−1 档）】
  命中量增至 __（超产能 __%）
  命中群体胜率差中位降至 __，与正常玩家难以区分
  Top1 订单盈利占比升至 __，结论被极端订单主导

【不选更严格（X+1 档）】
  命中量降至 __，覆盖不足，漏放敞口 __
  命中群体已是极端个案，规则失去筛查价值
  与 X 档风险质量差异 < 2x，不满足原则 ⑦
```

---

# 落地方案 {#sec-plan}

## 五阶段路径

| 阶段 | 时长 | 内容 | 退出条件 |
|---|---|---|---|
| P0 闸门 | 1 周 | 三条验证 SQL + 局级对账 + 测试线排除 | 全通过 |
| P1 标定 | 2 周 | §4/§5 全量网格 + 按桌分层 + 版本 ABC | 双档阈值确定 |
| P2 影子 | 4 周 | 只记录不动作 + **L0 十七 IP 必命中检验** | 误报预算守住 |
| P3 试运行 | 4 周 | Trial-L 档 + **人工全量复核 + 随机对照组** | 积累首批标签 |
| P4 生产 | 2 周 | 用 P3 标签重算 + OOT 终检 | ΔGGR CI 下界 > 0 |

::: {.callout-important}
## P3 的随机对照组不可省略

P3 的人工复核标签是**条件抽样**——只覆盖被规则抓出来送审的案件。
用它算召回率会严重高估。

**必须同时设随机对照组**：从**未命中**群体中随机抽同等数量送审。
省掉这一步，P4 的所有精度数字都是假的。
:::

## 分群商业动作

| 分群 | 动作 | 成本 | 收益 | 净收益 |
|---|---|---|---|---|
| V1 核心 | 返水上浮 x bp / 专属服务 | Σ流水×Δbp + 服务成本 | 留存↑ × CLV | ΔRetention×CLV − 成本 |
| V2 稳定 | 阶梯返水 / 流失预警 | 预警系统 + 挽回激励 | 流失↓ | ΔChurn×CLV − 成本 |
| R1 尾段 | **产品侧提前封盘** / 降桌限 | 正常客体验损失（需 A/B） | 未来赢额↓ | G1 − 体验损失 |
| R2 团伙 | 整链复核 / 限同桌 | 人力 | 敞口↓ | G1 − L2 |
| R3 洗码 | 返水档位调整 | 可能流失部分流水 | 返水成本↓ | G2 − 流水损失 |
| R0 组合 | 立即复核 / 暂停 | 高人力 + 高误伤代价 | 敞口↓↓ | G1×高精度 − L1 − L2 |

::: {.callout-note}
## R1 建议优先走产品侧而非风控侧

若尾段优势经 @sec-29s 局内匹配**证实存在**，最优解未必是封禁，而是**产品改造**：

- 提前封盘（缩短窗口末端信息暴露）
- 对高 TIM 会员单独延后下注截止
- 封盘前 N 秒隐藏他人下注动态

**产品修改成本远低于人工复核，且无误伤申诉风险。**
从「抓人」转向「堵漏」——这是顶级运营方与执法式风控的分野。
:::

## 监控与回滚

| 监控项 | 频率 | 触发 | 动作 |
|---|---|---|---|
| 命中率 | 每日 | 偏离基线 ±50% | 告警 |
| 特征 PSI | 每周 | > 0.25 | 重标定评审 |
| 误报率 | 每周 | 超误报预算 | 回滚上一档 |
| **ΔGGR 实测** | 每月 | 连续 2 月 < 0 | **下线该规则** |
| 局级对账差额 | 每日 | ≠ 0 | 停用该 cohort |

**健康指标永不贡献风险分。** 把管道故障混入风险分，
会把技术问题误判为会员行为异常。

---

---

# 评分落库与接口服务：从报告到生产 {#sec-serving}

> 需求原话：**「最终目标是建立打分系统，给风险用户打分评级。
> 落地到数据库或者 kv 中，以接口形式供后端调用。」**
>
> 本章交付四件东西：**① 分数怎么合成 → ② 存成什么表 → ③ 缓存怎么设计 →
> ④ 后端怎么调**。全部给到可直接拿去实施的粒度。

## 一、风险总分的合成公式（并非主观设定的加权和）

$$\text{RiskScore}_i \;=\; 100\cdot\sigma\!\Big(\textstyle\sum_{k} w_k\, z_{ik}\Big),
\qquad \sigma(x)=\frac{1}{1+e^{-x}}$$

其中 $z_{ik}$ 是第 $k$ 个风险维度的**分位归一分**（0–100 排名分，抗极端值），
$w_k$ 是权重。**权重不是人定的**，由两条路径给出：

| 路径 | 方法 | 何时用 |
|---|---|---|
| **主路径** | 以 L0 金标准 + 人工確認樣本为标签，跑 L1 正则 logistic，取系数为 $w_k$ | 有标签时 |
| **备路径** | 因子正交化后按解释方差 + AHP 层次分析，交由风控主管配对比较 | 标签不足时（当前 125 个正样本即属此列） |

::: {.callout-important}
## 加权前必须先做因子正交化——这一条没有例外

流水、洗码量、订单数三者相关系数常 >0.9。
**直接加权 = 把同一个信号数了三遍**，风险分被规模维度绑架，
最后排出来的是「大户榜」不是「风险榜」。

强制流程：**任何新增风险因子，进入加权公式前必须先过相关性检验**
（|corr| > 0.7 即需正交化或二选一），并把 VIF 记入模型卡。
:::

```{r}
#| label: score-compose
#| echo: true
## 风险总分合成器：分位归一 → 正交化检查 → 加权 → sigmoid → 0-100
compose_risk_score <- function(df, dims, weights = NULL, corr_cut = 0.7) {
  stopifnot(all(dims %in% names(df)))
  Z <- as.data.frame(lapply(df[dims], function(x) {
    x <- suppressWarnings(as.numeric(x))
    r <- rank(x, na.last = "keep", ties.method = "average")
    n <- sum(!is.na(x)); if (n == 0) return(rep(NA_real_, length(x)))
    (r - 0.5) / n                                   # 0-1 分位分
  }))
  ## ① 共线诊断：把高相关对显式列出来，不静默加权
  cm <- suppressWarnings(stats::cor(Z, use = "pairwise.complete.obs"))
  hi <- which(abs(cm) > corr_cut & upper.tri(cm), arr.ind = TRUE)
  collinear <- if (nrow(hi)) data.frame(
      因子A = rownames(cm)[hi[, 1]], 因子B = colnames(cm)[hi[, 2]],
      相关系数 = round(cm[hi], 3)) else data.frame()
  ## ② 权重：未给则按等权，并明确标注为「未校准」
  w <- if (is.null(weights)) setNames(rep(1 / length(dims), length(dims)), dims)
       else weights[dims] / sum(weights[dims])
  lin <- as.matrix(Z) %*% matrix(w, ncol = 1)
  lin <- scale(lin)[, 1]                            # 标准化后再过 sigmoid
  list(score = round(100 / (1 + exp(-lin)), 2),
       weights = w, collinear = collinear,
       calibrated = !is.null(weights))
}

## 评级映射：分数 → 等级 → 动作。断点一律取分位数，不写死 15/30/50/70/85
risk_grade <- function(score, cuts = c(.50, .80, .95, .99)) {
  q <- stats::quantile(score, cuts, na.rm = TRUE)
  cut(score, breaks = c(-Inf, q, Inf), right = FALSE,
      labels = c("G0 正常", "G1 关注", "G2 观察", "G3 调查", "G4 处置"))
}
```

```{r}
#| label: grade-policy
#| echo: false
tibble::tribble(
  ~等级, ~分位带, ~含义, ~系统动作, ~人工动作, ~可申诉,
  "**G0 正常**","< P50","无异常信号","无","无","—",
  "**G1 关注**","P50–P80","轻度偏离","仅打标，不改任何权益","无","—",
  "**G2 观察**","P80–P95","多维度同时偏离","进观察池，日更监控","无","是",
  "**G3 调查**","P95–P99","结构证据初步闭合","**结算侧**：佣金缓发","人工复核（附完整证据链）","是",
  "**G4 处置**","≥ P99 且命中结构证据","三链闭合（对打+连号+单链）","限红 → 冻结结算 → 退水追回","主管双签","是"
) |> aurora_kb(caption="五级评级 → 动作映射（断点为动态分位，随数据自动重算）")
```

::: {.callout-warning}
**G4 必须是「分数高」与「结构证据闭合」两个条件同时成立**，不能单靠分数。
分数是排序工具，证据才是处置依据。**系统永远没有自动封号权限**——
G3/G4 一律产出「建议动作 + 证据链」，由人执行。
:::

## 二、数据库表结构（DDL）

> ▸ 本节取数一律以 SQL 总包内的同名口径为准（总包对应条目待认领）；此处原内嵌的 SQL 底稿已迁入 @sec-sql-archive 归档 **A-19**。

::: {.callout-tip}
## `risk_score_reason` 这张表不是可选项

没有归因表的评分系统在实务中必然崩：客人申诉时答不出「为什么」，
风控专员复核时看不到证据，模型更新后没法对比谁变了。
**归因表的存在，本身就是风控专员评分「命中率」维度可计算的前提**（@sec-radar）。
:::

## 三、KV 缓存设计（Redis）

```text
# ── 键设计（版本号进键名，灰度与回滚靠切前缀，不靠删数据）──────────
a168:risk:v1:member:{member_id}      → Hash   TTL 26h
    score           风险总分 0-100
    grade           G0..G4
    types           "T1,T3"
    rules           "R02,R03"
    reward          赏项分
    punish          罚项分
    composite       赏 − 罚
    model_version   v1.3.0
    score_date      2026-08-07
    updated_at      epoch 秒

a168:risk:v1:dealer:{eid}            → Hash   TTL 26h   （荷官）
a168:risk:v1:agent:{agent_id}        → Hash   TTL 26h   （代理）
a168:risk:v1:analyst:{staff_id}      → Hash   TTL 26h   （风控专员）

a168:risk:v1:pair:{uid_small}:{uid_big} → Hash TTL 26h  （R-02 同桌对，含 lift）
a168:risk:v1:grade:{G3|G4}           → Set          （当日名单，供后台批量拉取）
a168:risk:v1:meta                    → Hash         （model_version / 生成时间 / 覆盖实体数）
```

**四条缓存纪律**：

1. **TTL 26 小时**，比 24 小时日更多留 2 小时缓冲——
   跑批延迟时读到**昨天的分**，好过读到**空**（空会被后端当作 G0 放行）。
2. **缺 key 一律按 G0 处理，并打点告警**。风控系统失效时的默认必须是**放行**，
   不是拦截——把所有人拦下来的损失，远大于漏放一天。
3. **版本号进键名**（`v1`）。新模型灌 `v2` 前缀，后端切读前缀即灰度，
   出问题切回 `v1` 即回滚，**永远不要原地覆盖**。
4. **写入用 pipeline + `HSET` 批量**，单会员单次往返在百万级实体下会跑一整夜。

## 四、接口契约（FastAPI）

```yaml
# ── OpenAPI 摘要（完整 spec 由 FastAPI 自动生成于 /docs）──────────
GET  /v1/risk/member/{member_id}
     → 200 {member_id, score, grade, types[], rules[], reward, punish,
            composite, model_version, score_date, reasons[]}
     → 404 未评分（后端按 G0 处理）
     参数 with_reasons=bool（默认 false；true 时回归因明细，走 DB 不走缓存）

POST /v1/risk/batch
     ← {entity_type, ids: [...]}   单次上限 1000
     → 200 {items: [...], missing: [...]}

GET  /v1/risk/pair?uid1=&uid2=
     → 200 {same_rate, jaccard, lift, n_same_orders, community_id, grade}

GET  /v1/risk/grade/{grade}?limit=&offset=
     → 200 当日该等级名单（G3/G4 供复核工作台拉取）

POST /v1/risk/action        （写：登记处置，返回 action_id）
POST /v1/risk/appeal        （写：登记申诉，触发复核）
GET  /v1/risk/health        → {model_version, score_date, coverage, lag_seconds}
```

```python
# ── FastAPI 最小可用实现（生产版加鉴权/限流/链路追踪）─────────────
from fastapi import FastAPI, HTTPException, Query
from pydantic import BaseModel
from typing import List, Optional
import redis, json, os

app = FastAPI(title="a168 风控评分服务", version="1.0")
R = redis.Redis(host=os.getenv("REDIS_HOST", "127.0.0.1"),
                port=6379, decode_responses=True)
KV_PREFIX = os.getenv("RISK_KV_PREFIX", "a168:risk:v1")   # 灰度/回滚只改这里

class RiskOut(BaseModel):
    entity_id: str
    score: float = 0.0
    grade: str = "G0"
    types: List[str] = []
    rules: List[str] = []
    composite: Optional[float] = None
    model_version: str = "unknown"
    score_date: Optional[str] = None
    source: str = "kv"

def _fetch(entity_type: str, eid: str) -> Optional[dict]:
    return R.hgetall(f"{KV_PREFIX}:{entity_type}:{eid}") or None

def _to_out(eid: str, h: Optional[dict]) -> RiskOut:
    # ★ 缺 key 一律按 G0 放行：风控失效时的默认必须是放行，不是拦截
    if not h:
        return RiskOut(entity_id=eid, source="default-G0")
    return RiskOut(
        entity_id=eid,
        score=float(h.get("score", 0) or 0),
        grade=h.get("grade", "G0"),
        types=[t for t in (h.get("types") or "").split(",") if t],
        rules=[t for t in (h.get("rules") or "").split(",") if t],
        composite=float(h["composite"]) if h.get("composite") else None,
        model_version=h.get("model_version", "unknown"),
        score_date=h.get("score_date"))

@app.get("/v1/risk/member/{member_id}", response_model=RiskOut)
def get_member(member_id: str, with_reasons: bool = Query(False)):
    out = _to_out(member_id, _fetch("member", member_id))
    if with_reasons:
        # 归因走 DB（risk_score_reason），不进缓存：体积大、调用稀疏
        pass
    return out

@app.post("/v1/risk/batch")
def batch(entity_type: str, ids: List[str]):
    if len(ids) > 1000:
        raise HTTPException(413, "单次上限 1000")
    pipe = R.pipeline()
    for i in ids:
        pipe.hgetall(f"{KV_PREFIX}:{entity_type}:{i}")
    rows = pipe.execute()
    items = [_to_out(i, h).dict() for i, h in zip(ids, rows)]
    return {"items": items,
            "missing": [i for i, h in zip(ids, rows) if not h]}

@app.get("/v1/risk/health")
def health():
    meta = R.hgetall(f"{KV_PREFIX}:meta") or {}
    return {"model_version": meta.get("model_version", "unknown"),
            "score_date": meta.get("score_date"),
            "coverage": int(meta.get("coverage", 0)),
            "kv_prefix": KV_PREFIX}
```

## 五、上线纪律：影子期、灰度、回滚

```{r}
#| label: serving-rollout
#| echo: false
tibble::tribble(
  ~阶段, ~时长, ~做什么, ~通过条件, ~失败动作,
  "**S0 影子期**","2 周","接口全量输出，后端**只记录不执行**","分数分布稳定；G3+G4 日均量 ≤ 复核产能","回退调阈值",
  "**S1 灰度 5%**","2 周","随机 5% 会员执行动作，95% 为对照","@sec-strategy-bt 四闸全过；误伤率 ≤ 本层现算上限","切回 v1 前缀",
  "**S2 灰度 30%**","4 周","扩到 30%，保留随机对照组","累计净增益 5% 分位 > 0","降回 5%",
  "**S3 全量**","持续","全量执行，**永久保留 3% 随机对照组**","月度复检四闸","立即切前缀回滚",
  "**回滚**","随时","`RISK_KV_PREFIX` 切回上一版本","—","30 秒内生效"
) |> aurora_kb(caption="评分服务上线路径（对照组永久保留——没有对照组就无法证明其在盈利）")
```

::: {.callout-important}
## 为什么要永久保留 3% 随机对照组

没有对照组，「上线后 GGR 涨了」永远说不清是模型的功劳还是季节、汇率、活动的功劳。
**3% 的对照成本，换的是持续证明这套系统值钱的能力。**
一旦哪天四闸复检不过，也能立刻看出是模型退化还是市场变了。

监控四项日更看板：**覆盖率、G3+G4 日均量、误伤率（申诉推翻比）、
命中人群 hold% 与对照差**。任一连续 3 日越界即触发人工介入。
:::
