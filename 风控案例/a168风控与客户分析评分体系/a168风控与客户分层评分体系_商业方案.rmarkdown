  pair <- length(unique(paste(x$uid, x$dealer_id)))
  has_ctrl <- any(grepl("对照|control|group|arm", names(x), ignore.case = TRUE))
  tibble::tibble(
    项目 = c("日维度导出", "覆盖营业日", "覆盖周数", "玩家×荷官组合",
             "上方三条序列", "对照组标识"),
    实测 = c(glue::glue("✅ R03b_player_dealer_daily.csv 已就位（SQL 总包 §R03b）"),
             glue::glue("{length(unique(dt))} 日（{min(dt)} ~ {max(dt)}）"),
             as.character(length(unique(format(dt, "%G-W%V")))),
             format(pair, big.mark = ","),
             "命中组合数 · 误判率代理 · 关联漏损（按周展开，可悬停读数）",
             if (has_ctrl) "面板含对照组标识，可直接做双重差分"
             else "面板不含对照组标识——增幅类因果效应此处无从估计")) |>
    aurora_kb(caption = paste0(
