::: {.callout-note}
## 贝叶斯层级模型为什么在荷官评分里不可替代

全场 1,856 名员工中荷官若干，**每位荷官的样本量差异极大**：
有人当值 139 天，有人只上过 3 天。用裸 Z-score 排名，
**排在最前面的永远是小样本荷官**——这是统计噪声，不是风险。

层级模型（随机截距 + 随机斜率）会把小样本荷官的估计**向全体均值收缩**，
样本越少收缩越狠。这样榜首才是真的异常，而不是「上班天数少」。
形式为 $\text{logit}(\pi_{ij})=\alpha+u_j+(\beta+v_j)x_{ij},\; u_j\sim\mathcal N(0,\sigma_u^2)$。

**工程告诫**（源自既往实测）：不要把 `win_rate` 放进自变量——
它是因变量的直接构成，属数据泄漏，$R^2$ 会虚高到毫无风控意义；
`turnover` 必须 `log1p` + 标准化，否则 NUTS 必然发散。
:::

```{python}
#| label: arsenal-extra
#| error: true
#| echo: true
# ── 竞技场扩编：把「已备接口」变成真正跑起来的模型 ────────────────────
#    只在面板就位且依赖装齐时执行；任何一项缺失只跳过该项，不中断渲染
import os, warnings, hashlib, pickle, json
warnings.filterwarnings("ignore")
ARSENAL_TBL = []
try:
    import numpy as np, pandas as pd
    _AR_ENV = True
except ImportError as e:
    print(f"⛔ Python 环境缺件（{e}）——军械库扩编跳过"); _AR_ENV = False

# ── ★ 指纹缓存（与 R 侧同一目录、同一套语义）────────────────────
#    指纹 = 输入文件内容哈希 + 参数 + 算法版本号。三者任一变化即重算。
#    只看 mtime 是不够的：同步工具可能保留 mtime 却改内容。
_CACHE_DIR = getattr(r, "CACHE_DIR_PY", None) or f"{r.DATA_DIR}/_cache"
os.makedirs(_CACHE_DIR, exist_ok=True)
_FORCE = str(os.environ.get("A168_FORCE_RECOMPUTE", "")).upper() in ("1", "TRUE", "YES")
CACHE_LOG_PY, TIMING_PY, HEALTH_PY = [], [], []
import sys, time

def _pg(msg):                      # 进度写 stderr：控制台可见，不灌进正文
    sys.stderr.write(msg); sys.stderr.flush()

def py_timed(label, fn, threshold=3.0):
    t0 = time.time(); _pg(f"⏳ [{label}] 开始 …\n")
    val = fn(); el = time.time() - t0
    _pg(f"{'✅' if el >= threshold else '·'} [{label}] 完成，用时 {el:.1f}s\n")
    TIMING_PY.append({"任务": label, "耗时秒": round(el, 2),
                      "量级": "秒内" if el < 1 else "数秒" if el < threshold
                              else "分钟内" if el < 60 else "★ 分钟级"})
    return val

def py_contract(path, need_cols, sql_id):
    """读入前后做存在性 / 表头 / 指纹三重核验，并给出该采取的措施。"""
    if not os.path.exists(path):
        HEALTH_PY.append({"文件": os.path.basename(path), "来源SQL": sql_id,
                          "状态": "⬜ 未就位", "行数": "—", "指纹": "—",
                          "应采取措施": f"按 @sec-runbook 跑 SQL {sql_id} 导出"})
        return None
    fp = _fp_file(path)
    df = _rd(path) if "_rd" in globals() else _read_any(path)
    df.columns = [str(c).strip().replace("\ufeff", "") for c in df.columns]
    miss = [c for c in need_cols if c not in df.columns]
    st = "🔴 表头不符" if miss else "🟢 已核验"
    act = (f"缺必需列 {miss}；核对 SQL {sql_id} 的列别名"
           if miss else "存在性/表头/指纹三项均通过")
    HEALTH_PY.append({"文件": os.path.basename(path), "来源SQL": sql_id, "状态": st,
                      "行数": f"{len(df):,}", "指纹": fp["h"][:12], "应采取措施": act})
    return df

def _fp_file(path, big_mb=200):
    if not os.path.exists(path):
        return {"kind": "missing", "n": 0, "h": "none"}
    sz = os.path.getsize(path)
    if sz > big_mb * 1024**2:                      # 超大文件降级为 元信息+抽样
        h = hashlib.blake2b(digest_size=8)
        with open(path, "rb") as fh:
            h.update(fh.read(4 << 20)); fh.seek(max(0, sz - (4 << 20))); h.update(fh.read())
        return {"kind": "file-sampled(大文件降级)", "n": sz, "h": h.hexdigest()}
    h = hashlib.blake2b(digest_size=8)
    with open(path, "rb") as fh:
        for blk in iter(lambda: fh.read(1 << 20), b""):
            h.update(blk)
    return {"kind": "file-content", "n": sz, "h": h.hexdigest()}

def _fp_key(key, inputs, params, version):
    fps = [_fp_file(p) for p in inputs]
    fp = hashlib.blake2b(
        json.dumps([fps, params or {}, version], sort_keys=True, default=str).encode(),
        digest_size=8).hexdigest()
    return fp, fps, os.path.join(_CACHE_DIR, f"{key}__{fp}.pkl")

def py_cache_get(key, inputs=(), params=None, version="v1"):
    """★ 必须在**开跑之前**调用：命中即整段跳过，才谈得上省时间。
       缓存须在训练**之前**查：放在训练之后只缓存结果、省不了训练，那是假缓存。"""
    fp, fps, path = _fp_key(key, inputs, params, version)
    if not _FORCE and os.path.exists(path):
        try:
            with open(path, "rb") as fh:
                val = pickle.load(fh)
            CACHE_LOG_PY.append({"缓存键": key, "版本": version, "状态": "🟢 命中缓存（跳过全部计算）",
                                 "输入": " + ".join(f"{z['kind']}:{z['n']}" for z in fps),
                                 "指纹": fp[:12], "说明": f"读 {os.path.basename(path)}"})
            return val
        except Exception as e:
            CACHE_LOG_PY.append({"缓存键": key, "版本": version, "状态": f"🔴 缓存损坏：{e}",
                                 "输入": "—", "指纹": fp[:12], "说明": "已忽略，改为重算"})
    return None

def py_cache_put(key, val, inputs=(), params=None, version="v1", note="首次计算"):
    fp, fps, path = _fp_key(key, inputs, params, version)
    stale = [f for f in os.listdir(_CACHE_DIR)
             if f.startswith(key + "__") and f.endswith(".pkl") and f != os.path.basename(path)]
    try:
        with open(path, "wb") as fh:
            pickle.dump(val, fh, protocol=4)
        for f in stale:
            os.remove(os.path.join(_CACHE_DIR, f))
        st = "🟡 重算并落盘"
    except Exception as e:
        st = f"🔴 落盘失败：{e}"
    CACHE_LOG_PY.append({"缓存键": key, "版本": version, "状态": st,
                         "输入": " + ".join(f"{z['kind']}:{z['n']}" for z in fps),
                         "指纹": fp[:12], "说明": note if not stale else "指纹变了（数据/参数/版本已改）"})
    return val

def py_cached(key, fn, inputs=(), params=None, version="v1"):
    """兼容旧调用：先 get 再 put。新代码请直接用 get/put 以便整段跳过。"""
    hit = py_cache_get(key, inputs, params, version)
    if hit is not None:
        return hit
    return py_cache_put(key, fn(), inputs, params, version)

def _ar_resolve(base):
    """★ 自动识别文件（军械库侧，独立可粘贴）：精确 → 忽略大小写 → 前缀近似。"""
    d = r.DATA_DIR
    p = os.path.join(d, base)
    if os.path.exists(p):
        return p
    try:
        fs = os.listdir(d)
    except FileNotFoundError:
        return None
    low = {f.lower(): f for f in fs}
    if base.lower() in low:
        return os.path.join(d, low[base.lower()])
    st = os.path.splitext(base)[0].lower()
    c = [f for f in fs if f.lower().startswith(st) and f.lower().endswith(".csv")]
    if c:
        c.sort(key=lambda f: -os.path.getsize(os.path.join(d, f)))
        print(f"ℹ️ [军械库] S05 以近似名命中：{c[0]}")
        return os.path.join(d, c[0])
    return None

_PANEL = _ar_resolve("S05_member_month_panel.csv")

## ③ 最外层兜底：这一项再怎么失败也不该拖垮整份报告的渲染。
##    注意 try/except 只挡得住 Python 异常；进程级崩溃（OOM/原生库 abort）
##    挡不住——那要靠上面的下采样与小批量从源头避免。
try:
    if _AR_ENV and _PANEL is not None:
        def _rd(p):
            for enc in ("utf-8-sig","utf-8","gb18030","gbk","big5","latin1"):
                try: return pd.read_csv(p, encoding=enc)
                except (UnicodeDecodeError, LookupError): continue
            raise RuntimeError(f"{p} 所有候选编码均失败")
        dfp = py_contract(_PANEL, ["member_id"], "S-05")
        if dfp is not None and sum(("\ufffd" in str(c)) or ("�" in str(c))
                                   for c in dfp.columns) >= 2 and len(dfp.columns) == 10:
            dfp.columns = ["member_id","bet_date","流水贡献","游戏输赢贡献","活跃稳定",
                           "退水支出","n_ip","n_chain","round_key","risk_label"]
            print("ℹ️ [S05] 表头乱码已按位置恢复（军械库侧兜底；治本须 S-05 改英文列名重导）")
        if dfp is None:
            dfp = pd.DataFrame()          # 契约不过 → 空表走后续「特征不足」分支
        ## S05 面板不含 risk_label，
    ##   旧版一句「面板缺标签列——跳过」就把整章废了。
    ##   实际上标签可以现造：读 K01 的种子合并结果 / R01·R02·R03 三份规则命中，
    ##   把命中会员标为 1。造不出来才跳过，并说明差什么。
    ycol = "risk_label" if "risk_label" in dfp.columns else None
    if ycol is None and "member_id" in dfp.columns:
        _seed = set()
        def _mk(fn, fx):
            p = f"{r.DATA_DIR}/{fn}"
            if not os.path.exists(p): return
            try:
                d = _rd(p); d.columns = [str(c).strip() for c in d.columns]; fx(d)
            except Exception as e:
                print(f"ℹ️ 造标签读 {fn} 失败：{e}")
        _mk("_T4_expanded.csv", lambda d: _seed.update(
            d.loc[d.get("是否种子", 0).astype(int) == 1, d.columns[0]].astype(str)))
        _mk("R01_late_shoe.csv", lambda d: _seed.update(
            d.loc[(pd.to_numeric(d["late_share"], errors="coerce") >= .70)
                  & (pd.to_numeric(d["stake_ramp"], errors="coerce") >= 2)
                  & (pd.to_numeric(d["roi_late"], errors="coerce") > 0), "uid"].astype(str)))
        _mk("R03_player_dealer.csv", lambda d: _seed.update(
            d.loc[(pd.to_numeric(d["n_rounds_eff"], errors="coerce") >= 30)
                  & (pd.to_numeric(d["z_score"], errors="coerce") >= 4), "uid"].astype(str)))
        def _r02(d):
            m = pd.to_numeric(d["same_rate"], errors="coerce") >= .30
            _seed.update(d.loc[m, "uid1"].astype(str)); _seed.update(d.loc[m, "uid2"].astype(str))
        _mk("R02_same_table.csv", _r02)
        if len(_seed) >= 10:
            dfp["risk_label"] = dfp["member_id"].astype(str).isin(_seed).astype(int)
            ycol = "risk_label"
            print(f"ℹ️ 面板无 risk_label → 由五路规则命中现造标签："
                  f"正样本 {int(dfp[ycol].sum()):,} / {len(dfp):,}")
        else:
            print(f"ℹ️ 无法现造标签（可用种子仅 {len(_seed)} 个，需 ≥10）"
                  f"——请先导出 R01/R02/R03 或跑通 T4")
        feats = [c for c in dfp.columns
                 if c not in ("member_id","bet_date","round_key",ycol)
                 and pd.api.types.is_numeric_dtype(dfp[c])]

        ## 缓存必须在**开跑之前**查。
        ##   放在全部训练之后只缓存结果——
        ##   GRU/Transformer 各 150 轮、HMM 300 轮照跑不误，等于没缓存。
        ## 进程级崩溃防护：本块曾在 77% 处直接带走渲染进程且不留错误信息，
        ##   这是**进程级崩溃**（内存耗尽 / 原生库 abort），不是 Python 异常——
        ##   异常会打印，崩溃不会。S05 面板动辄数十万行，
        ##   若把整张表塞成一个张量、全批量跑 150 轮，OOM 是必然。
        ##   三道闸：① 建模前分层下采样封顶 ② 改小批量 ③ 最外层 try/except 兜底。
        _AR_PARAMS = {"folds": 3, "epochs": 60, "hmm_iter": 300, "batch": 512,
                      "max_n": 20000, "kr_cap": 4000, "min_pos": 20, "seed": 20260807}
        _AR_HIT = py_cache_get("arsenal", inputs=[_PANEL], params=_AR_PARAMS, version="v3")
        if _AR_HIT is not None:
            ARSENAL_TBL = _AR_HIT
            print("🟢 军械库命中缓存，跳过全部训练（改参数或换数据即自动失效）")
        elif ycol is None or dfp[ycol].nunique() < 2 or len(feats) < 3:
            print(f"ℹ️ 军械库跳过：标签列 {'有' if ycol else '无'}、"
                  f"数值特征 {len(feats)} 个（需 ≥3）、"
                  f"标签取值 {dfp[ycol].nunique() if ycol else 0} 种（需 ≥2）")
        else:
            X = dfp[feats].replace([np.inf,-np.inf], np.nan).fillna(0).values.astype("float32")
            y = dfp[ycol].astype(int).values
            # ① 分层下采样：正样本全留，只降采样负样本（极不平衡下唯一正确的方向）
            _MAXN = _AR_PARAMS["max_n"]
            if len(y) > _MAXN:
                _rng = np.random.default_rng(_AR_PARAMS["seed"])
                _pos = np.flatnonzero(y == 1); _neg = np.flatnonzero(y == 0)
                _kneg = max(1, min(len(_neg), _MAXN - len(_pos)))
                _idx = np.sort(np.concatenate([_pos, _rng.choice(_neg, _kneg, replace=False)]))
                print(f"ℹ️ 面板 {len(y):,} 行 → 分层下采样至 {len(_idx):,} 行"
                      f"（正样本 {len(_pos):,} 全留），防止 OOM")
                X, y = X[_idx], y[_idx]
            from sklearn.model_selection import StratifiedKFold
            from sklearn.metrics import roc_auc_score, average_precision_score
            from sklearn.preprocessing import StandardScaler
            Xs = StandardScaler().fit_transform(X)
            skf = StratifiedKFold(n_splits=3, shuffle=True, random_state=20260807)

            def _bench(name, fit_pred, note=""):
                au, ap, t0 = [], [], time.time()
                folds_ = list(skf.split(Xs, y)); nf = len(folds_)
                for k, (tr_i, te_i) in enumerate(folds_, 1):
                    try:
                        s = fit_pred(Xs[tr_i], y[tr_i], Xs[te_i])
                        au.append(roc_auc_score(y[te_i], s))
                        ap.append(average_precision_score(y[te_i], s))
                        el = time.time() - t0
                        _pg(f"\r  {name} {'█'*int(20*k/nf)}{'░'*(20-int(20*k/nf))} "
                            f"{k}/{nf}  已用 {el:5.1f}s  剩余 ~{el/k*(nf-k):5.1f}s")
                    except Exception as e:
                        _pg("\n"); print(f"⛔ [{name}] {e}"); return
                _pg("\n")
                TIMING_PY.append({"任务": f"军械库·{name}",
                                  "耗时秒": round(time.time() - t0, 2),
                                  "量级": "见上"})
                ARSENAL_TBL.append({"模型": name,
                                    "AUC": round(float(np.mean(au)), 4),
                                    "PR-AUC": round(float(np.mean(ap)), 4),
                                    "折数": len(au), "备注": note})

            # ① Isolation Forest（无监督罕见度，作监督对照）
            try:
                from sklearn.ensemble import IsolationForest
                _bench("Isolation Forest",
                       lambda a,b,c: -IsolationForest(n_estimators=300, random_state=1,
                                                      n_jobs=1).fit(a).score_samples(c),
                       "无监督：不看标签也能排多远")
            except ImportError: pass

            # ② GRU 序列头（把每位会员的特征当作单步序列，接 GRU 编码）
            try:
                import torch, torch.nn as nn
                class GRUHead(nn.Module):
                    def __init__(s, d, h=32):
                        super().__init__(); s.g = nn.GRU(d, h, batch_first=True)
                        s.o = nn.Sequential(nn.Linear(h, 16), nn.ReLU(), nn.Linear(16, 1))
                    def forward(s, x):
                        z, _ = s.g(x); return s.o(z[:, -1, :]).squeeze(-1)
                def _fit_torch(model, a, b, c, pos_weight=None):
                    """② 小批量训练 + 分块推断：全批量张量在数十万行上必然 OOM。"""
                    EP, BS = _AR_PARAMS["epochs"], _AR_PARAMS["batch"]
                    xt = torch.tensor(a).unsqueeze(1); yt = torch.tensor(b, dtype=torch.float32)
                    opt = torch.optim.Adam(model.parameters(), 1e-3)
                    lf = nn.BCEWithLogitsLoss(pos_weight=pos_weight)
                    n = xt.shape[0]
                    for _ in range(EP):
                        perm = torch.randperm(n)
                        for k in range(0, n, BS):
                            sel = perm[k:k+BS]
                            opt.zero_grad(); loss = lf(model(xt[sel]), yt[sel])
                            loss.backward(); opt.step()
                    model.eval(); outs = []
                    ct = torch.tensor(c).unsqueeze(1)
                    with torch.no_grad():
                        for k in range(0, ct.shape[0], 4096):
                            outs.append(torch.sigmoid(model(ct[k:k+4096])).numpy())
                    return np.concatenate(outs) if outs else np.zeros(0)

                def _gru(a, b, c):
                    pw = torch.tensor(max((b==0).sum()/max((b==1).sum(),1), 1.0),
                                      dtype=torch.float32)
                    return _fit_torch(GRUHead(a.shape[-1]), a, b, c, pos_weight=pw)
                _bench("GRU 序列头", _gru, "单步序列；面板补足月序后升级为多步")

                # ③ Transformer 编码器头（注意力可解释）
                class TrfHead(nn.Module):
                    def __init__(s, d, h=32, nh=4):
                        super().__init__()
                        s.p = nn.Linear(d, h)
                        s.e = nn.TransformerEncoderLayer(d_model=h, nhead=nh,
                                dim_feedforward=64, batch_first=True, dropout=0.1)
                        s.o = nn.Linear(h, 1)
                    def forward(s, x):
                        return s.o(s.e(s.p(x))[:, -1, :]).squeeze(-1)
                def _trf(a, b, c):
                    return _fit_torch(TrfHead(a.shape[-1]), a, b, c)
                _bench("Transformer 编码器头", _trf, "注意力权重可导出为「哪几天最关键」")
            except ImportError:
                print("ℹ️ torch 未装——GRU / Transformer 跳过")

            # ④ Regime Kernel：HMM 解码行为状态 → 分状态核回归
            #    实跑暴露的两处必修：
            #      修一 · MemoryError —— KernelRidge 要解 n×n 核矩阵，n=10 万时
            #             光矩阵就 80GB。改为每状态**分层抽样封顶 KR_CAP 条**，
            #             并优先走 Nystroem 近似核 + 线性 Ridge（内存 O(n·m)）。
            #      修二 · 样本内评估 —— 原来 fit 与 roc_auc_score 用的是同一批 idx，
            #             AUC 是拟合优度不是泛化能力，属自评自夸。改为训练/留出切分。
            KR_CAP   = _AR_PARAMS["kr_cap"]   # 每状态参与建模的样本上限（改它即令缓存失效）
            MIN_POS  = _AR_PARAMS["min_pos"]  # 该状态至少要有这么多正样本才值得建模
            MIN_TEST_POS = 6  # 留出集里至少要有这么多正样本，AUC 才有意义
            rk_note = []
            try:
                from hmmlearn.hmm import GaussianHMM
                from sklearn.kernel_approximation import Nystroem
                from sklearn.linear_model import Ridge
                from sklearn.model_selection import train_test_split
                Xh = Xs[:, :min(5, Xs.shape[1])]
                hm = GaussianHMM(n_components=3, covariance_type="diag",
                                 n_iter=300, tol=1e-3, random_state=1).fit(Xh)
                converged = bool(getattr(getattr(hm, "monitor_", None), "converged", False))
                st = hm.predict(Xh)
                per_state, rng = [], np.random.default_rng(20260807)
                for s_i in np.unique(st):
                    idx = np.flatnonzero(st == s_i)
                    pos, neg = idx[y[idx] == 1], idx[y[idx] == 0]
                    # ★ 修三（2026-08-07 二次实跑暴露）：极端不平衡下的两个连锁问题
                    #   ① 原按比例抽样 k_pos = KR_CAP*占比 → 正样本仅剩 1 个，
                    #      train_test_split(stratify=) 直接抛
                    #      "least populated class has only 1 member"。
                    #   ② 就算侥幸切开，正样本个位数时的 AUC 是噪声，不是能力。
                    #   正确做法：**正样本一个不抽掉，只对负样本降采样**，
                    #   并设正样本下限，不够就明说跳过，不产出假数字。
                    if len(pos) < MIN_POS or len(neg) < MIN_POS:
                        rk_note.append(f"状态{int(s_i)}(正{len(pos)}/负{len(neg)}) 正样本不足，跳过")
                        continue
                    k_neg = min(len(neg), max(MIN_POS, KR_CAP - len(pos)))
                    idx = np.concatenate([pos, rng.choice(neg, k_neg, replace=False)])
                    yy = y[idx]
                    try:
                        tr_i, te_i = train_test_split(np.arange(idx.size), test_size=.3,
                                                      stratify=yy, random_state=1)
                    except ValueError as e:      # 分层仍不可行 → 明说，不硬切
                        rk_note.append(f"状态{int(s_i)} 分层切分失败：{e}")
                        continue
                    if int(yy[te_i].sum()) < MIN_TEST_POS:
                        rk_note.append(
                            f"状态{int(s_i)} 留出集正样本仅 {int(yy[te_i].sum())} 个"
                            f"（<{MIN_TEST_POS}），AUC 无意义，跳过")
                        continue
                    ny = Nystroem(kernel="rbf",
                                  n_components=min(300, len(tr_i)), random_state=1)
                    Ztr = ny.fit_transform(Xs[idx][tr_i]); Zte = ny.transform(Xs[idx][te_i])
                    mdl = Ridge(alpha=1.0).fit(Ztr, yy[tr_i])
                    per_state.append((int(s_i), int(idx.size), int(len(pos)),
                                      float(roc_auc_score(yy[te_i], mdl.predict(Zte)))))
                if per_state:
                    ARSENAL_TBL.append({
                        "模型": "Regime Kernel (HMM×Nyström核岭)",
                        "AUC": round(float(np.mean([p[3] for p in per_state])), 4),
                        "PR-AUC": np.nan, "折数": len(per_state),
                        "备注": ("三态解码" + ("(已收敛)" if converged else "(★未收敛，仅供参考)")
                                 + "：" + " / ".join(f"状态{p[0]}:{p[1]}条/正{p[2]}"
                                                    for p in per_state)
                                 + f"；负样本封顶 {KR_CAP}，正样本全留，30% 留出评估"
                                 + ("；" + "；".join(rk_note) if rk_note else ""))})
                else:
                    print("ℹ️ Regime Kernel 未产出——" + ("；".join(rk_note) if rk_note
                          else "各状态样本或标签不足"))
                    ARSENAL_TBL.append({
                        "模型": "Regime Kernel (HMM×Nyström核岭)",
                        "AUC": np.nan, "PR-AUC": np.nan, "折数": 0,
                        "备注": "⬜ 未产出：" + ("；".join(rk_note) if rk_note
                                else "各状态正样本不足") + "　←　这是结论，不是失败"})
            except ImportError as e:
                print(f"ℹ️ hmmlearn / sklearn 组件未装（{e}）——Regime Kernel 跳过")
            except MemoryError:
                print(f"⛔ Regime Kernel 内存不足——当前 KR_CAP={KR_CAP}，减半后重试")
            except Exception as e:
                # ★ 兜底：这一项再怎么失败也不能拖垮整个军械库
                print(f"⛔ Regime Kernel 异常（{type(e).__name__}: {e}）——已跳过，不影响其余模型")

            # 军械库整表落缓存：下次渲染若 S05 面板与参数未变，直接读回，
            # 省掉 GRU/Transformer 各 150 轮训练与 HMM 300 轮迭代
            ARSENAL_TBL = py_cached(
                "arsenal", lambda: ARSENAL_TBL, inputs=[_PANEL], version="v2",
                params={"folds": 3, "epochs": 150, "hmm_iter": 300,
                        # ★ 必须引用变量而非写死数字：写死会让 KR_CAP 改动无法使缓存失效，
                        #   下次渲染会拿旧参数的结果冒充新参数的结果——缓存说谎。
                        "kr_cap": KR_CAP, "min_pos": MIN_POS, "seed": 20260807})
            if ARSENAL_TBL:
                print(pd.DataFrame(ARSENAL_TBL).to_string(index=False))
    elif _AR_ENV:
        print("ℹ️ S05 面板未就位——军械库扩编待数据")
except MemoryError:
    print("⛔ 军械库内存不足——把 _AR_PARAMS['max_n'] 或 ['batch'] 减半后重跑")
except Exception as _e:
    print(f"⛔ 军械库异常（{type(_e).__name__}: {_e}）——已跳过，不影响其余章节")
```

```{r}
#| label: arsenal-table
#| echo: false
ar <- tryCatch(reticulate::py$ARSENAL_TBL, error = function(e) NULL)
if (length(ar)) {
  dplyr::bind_rows(lapply(ar, tibble::as_tibble)) |>
    dplyr::arrange(dplyr::desc(AUC)) |>
    aurora_kb(caption = "军械库扩编 · 三折分层交叉验证（PR-AUC 在极不平衡标签下比 AUC 更诚实）")
} else {
  tibble::tibble(
    状态 = "⬜ 待数据",
    说明 = "所待文件：数据库/S05_member_month_panel.csv（SQL 总包 §06 S-05；文件名近似亦可自动识别）。受影响输出：GRU / Transformer / Regime Kernel / Isolation Forest。导出后自动全跑",
    提醒 = "L1a 正样本仅 125 个（@sec-e1-dist）——**本节只报结构，不报精度召回**") |>
    aurora_kb(caption = "军械库扩编（待面板数据）")
}
```

::: {.callout-warning}
## 一条贯穿全文的诚实约束，在这里再说一次

人工風險單只有 **125 个正样本**（@sec-e1-dist）。
在这种标签稀缺度下，任何「AUC 0.9x」的宣称都必须附上 **PR-AUC** 与置信区间，
否则就是在用不平衡数据的天然高 AUC 骗人。

**本报告的立场**：模型天梯只用于**模型间相对排序**与**特征有效性诊断**，
**不用于对外宣称检测精度**。真正的上线判据是 @sec-strategy-bt 的四闸经济回测。
:::
# 与「一般均值」的正面比较：优化幅度到底有多少 {#sec-benchmark}

> 需求：**任何参数、维度、阈值、因子、p 值、顶级计数尤物，务必与一般基本统计学的
> 均值比较，才能凸显优化与优势**，并给出业绩增幅、误判概率与损失（夏普率、最大回撤等）。
>
> 立场先说清：**没有对照的优化都是自我宣称。** 本章把每一件工具都放到同一条基准线旁边，
> 基准线一律取「统计学上最朴素的那个做法」——通常就是**均值**。

## 一、四条基准线（每一项优化都必须跑赢其中对应的一条）

```{r}
#| label: bench-baselines
#| echo: false
tibble::tribble(
  ~维度, ~"一般统计学做法（基准）", ~本方案做法, ~凭什么说更优, ~失败则,
  "**中心估计**","算术均值","分位数（P50/P90/P99）+ 洗码量加权均值",
    "博彩流水是极端右偏：前 1% 会员可占三成流水。均值被少数巨鲸拖走，中位数才代表典型客人",
    "退回均值，但必须同时报偏度",
  "**阈值设定**","均值 ± k×标准差","训练窗分位数（每折独立重估）",
    "±kσ 假设近似正态；实测洗码量分布右偏严重，σ 本身被极值撑大，阈值会系统性偏松",
    "退回 ±3σ 并记录折间漂移",
  "**效应判定**","单次 t 检验的 p 值","五重检验 + 净化滚动回测 + 经济核算三层",
    "p 小只说明「不太可能是碰巧」，不说明「值得处置」。经济核算才回答后者",
    "判为「未能证实」，只画像不处置",
  "**策略评价**","累计净增益 / 折均净增益","净增益 5% 分位 + MASE + 索提诺 + 最大回撤",
    "均值为正只是运气不差；分位为正才是稳。MASE<1 才算比「什么都不做」强",
    "不上线"
) |> aurora_kb(caption = "四条基准线：本方案的每一项「优化」都对应一条必须跑赢的朴素做法")
```

## 二、基准对照引擎

```{r}
#| label: engine-core
#| echo: true
## 回测引擎的唯一定义处：@sec-benchmark 与 @sec-strategy-bt 共用这一份。
##   R 按顺序执行，本块必须排在两章的调用点之前。
##   改回测协议只改这里：折长、禁运期、阈值分位、回收率、流失系数。
## ═══════════════════════════════════════════════════════════════════
## 策略级净化滚动回测：训练窗定阈值 → 禁运 → 测试窗量业绩
## 指标：ΔGGR、hold% 差、误伤率、MASE(vs naive)、索提诺、命中留存
## ═══════════════════════════════════════════════════════════════════
## ★ mode 参数（本轮精度修正）：
##   "sliding"（默认）= 训练窗**定长滑动**，窗长恒为 train 天——
##     这才能让「训练窗长」成为一个含义清晰、可网格比较的超参数；
##   "anchored" = 训练窗左端锚定于首日、逐折扩张——旧行为，保留作对照。
##   旧实现名为 train=60 实为「首折 60 天、之后逐折加长」，两个语义混在
##   一个参数里，窗长网格比较在旧实现下不成立。修正记录见 @sec-changelog。
## ★ 折切分参数的**单一权威**：正文协议表、四处回测调用与缓存指纹一律取自此处，
##   改一处即全篇同步，杜绝「表里写 14、代码跑 7」这类不一致。
##   步长取 7（一周）而非 14：候选一律 7 的整倍数，且时间轴上的观测点加密一倍，
##   累计走势才看得出形状而非寥寥数点。
BT_PARAMS <- list(train = 63, embargo = 7, test = 14, step = 7, mode = "sliding")

## ── 误伤上限：按动作分层现算，不设统一数 ──────────────────────────────
##   对某人采取动作 a，设其确为风险者的概率为 p，则期望净值
##     EV(a) = p·g(a)·W − (1−p)·c(a)·H(a)·L
##   其中 W 为该人赢走额、L 为其输掉额，g 为挽回系数、c 为流失系数、
##   H 为误伤所毁掉的期数（终身价值折算倍数）。令 EV ≥ 0 解得可容忍的误伤率上限
##     f*(a) = g·W / ( g·W + c·H·L )                       （Elkan 2001 成本敏感准则）
##   动作越重，H 越大、上限越低；观察类动作无处置代价，上限不适用。
##   ★ g / c / H 三者与回收率、流失系数同属**情景参数**，非模型估计值；
##     其真值须待处置台账到位后由实际处置历史重估——平台现无此表（见 @sec-limit）。
ACT_TIER <- tibble::tribble(
  ~动作层,          ~本层动作,                 ~g,   ~c,   ~H,
  "L1 观察记录",    "不干预，仅留痕",          0.00, 0.00,  0,
  "L2 加密监控",    "提高采样率、关联抽查",    0.05, 0.02,  0.5,
  "L3 人工调查",    "调阅录像、人工复核",      0.20, 0.05,  1,
  "L4 结算侧处置",  "降返水、限红、延迟结算",  0.60, 0.15,  4,
  "L5 账户侧处置",  "冻结结算、追缴",          0.90, 0.35, 12)
fp_ceiling <- function(g, c, H, wl = 1) {
  d <- g * wl + c * H
  ifelse(d > 0, g * wl / d, NA_real_)      # H = 0 即无处置代价，上限不适用
}
## 本方案回测所模拟者为 L4 结算侧处置（gain() 取挽回 0.60、流失 0.15），
## 故四闸之③的上限取该层现算值，不再写死 20%。
FP_CEIL_L4 <- fp_ceiling(ACT_TIER$g[4], ACT_TIER$c[4], ACT_TIER$H[4])
purged_folds <- function(dates, train = BT_PARAMS$train, embargo = BT_PARAMS$embargo,
                         test = BT_PARAMS$test, step = BT_PARAMS$step,
                         mode = c("sliding", "anchored")) {
  if (missing(mode)) mode <- BT_PARAMS$mode
  mode <- match.arg(mode)
  d <- sort(unique(as.Date(dates)))
  out <- list(); i <- 1L
  while (TRUE) {
    tr_end <- d[1] + (train - 1) + (i - 1L) * step
    tr_beg <- if (mode == "sliding") tr_end - (train - 1) else d[1]
    te_beg <- tr_end + embargo + 1
    te_end <- te_beg + test - 1
    if (te_end > max(d)) break
    out[[length(out) + 1L]] <- list(
      fold = length(out) + 1L, tr = c(tr_beg, tr_end), te = c(te_beg, te_end))
    i <- i + 1L
  }
  out
}

## ── 折级检查点（继承自前作 binary-Q1Inter-HFT 的每折落盘设计）────────
##   cached() 只缓存整段回测；69 折逐日滚动若中途被 OOM 打断，前功尽弃。
##   本层按折落盘：面板指纹 + 折窗 + 参数 任一变化即该折重算，其余折直读。
##   面板指纹只算一次（panel_fp 由调用方传入），避免每折重哈希整张面板。
FOLD_CKPT_DIR <- file.path(CACHE_DIR, "bt_folds")
if (!dir.exists(FOLD_CKPT_DIR)) dir.create(FOLD_CKPT_DIR, showWarnings = FALSE)
fold_ckpt <- function(panel, fold, panel_fp, ..., ckpt_version = "v1") {
  key <- .hash(list(panel_fp, fold$tr, fold$te, list(...), ckpt_version))
  f <- file.path(FOLD_CKPT_DIR, paste0("fold_", fold$te[2], "_", substr(key, 1, 12), ".rds"))
  if (!FORCE_RECOMPUTE && file.exists(f)) return(readRDS(f))
  val <- bt_fold(panel, fold, ...)
  tryCatch(saveRDS(val, f, compress = "xz"), error = function(e) NULL)
  val
}

## 风险分现算器：★ 经验分位函数**只在训练窗上拟合**，再原样套到测试窗。
##   B-01 导出**刻意不含 risk_score**——分数是被拟合的量，在 SQL 里用全量
##   算好再回测，等于用未来数据定分数，是最隐蔽的一种泄漏。
RISK_FEATS <- c(late_share_d = 1, hedge_rate_d = 1, n_ip = 1,
                stake_cv_d = -1, roi_game_d = 1)   # +1 越大越可疑，-1 反之
fit_risk <- function(tr, feats = RISK_FEATS) {
  use <- intersect(names(feats), names(tr))
  if (!length(use)) return(NULL)
  fns <- lapply(use, function(cl) {
    v <- suppressWarnings(as.numeric(tr[[cl]])); v <- v[is.finite(v)]
    if (!length(v)) NULL else stats::ecdf(v) })
  names(fns) <- use
  fns <- fns[!vapply(fns, is.null, logical(1))]
  if (!length(fns)) return(NULL)
  w <- feats[names(fns)]
  function(d) {
    z <- vapply(names(fns), function(cl) {
      v <- suppressWarnings(as.numeric(d[[cl]]))
      p <- fns[[cl]](ifelse(is.finite(v), v, stats::median(v, na.rm = TRUE)))
      ifelse(is.finite(p), p, 0.5) * sign(w[[cl]]) }, numeric(nrow(d)))
    if (is.null(dim(z))) z <- matrix(z, nrow = nrow(d))
    100 * (rowMeans(z, na.rm = TRUE) + 1) / 2      # 映射到 0–100
  }
}

## 单折评估：阈值只由训练窗给出，测试窗只执行不调参
##   fixed_thr 非 NULL 时表示「朴素基线」——沿用固定阈值，不随折重估，
##   用来回答「重新估阈值这件事本身有没有价值」。
bt_fold <- function(panel, fold, q_thr = 0.99, action_recover = 0.60,
                    churn_cost = 0.15, fixed_thr = NULL) {
  tr <- panel[panel$bet_date >= fold$tr[1] & panel$bet_date <= fold$tr[2], , drop = FALSE]
  te <- panel[panel$bet_date >= fold$te[1] & panel$bet_date <= fold$te[2], , drop = FALSE]
  if (nrow(tr) < 100 || nrow(te) < 50) return(NULL)
  ## ⓪ 风险分：面板自带就用自带的；不带则用训练窗现拟合（B-01 走这条）
  if (!"risk_score" %in% names(panel)) {
    scorer <- fit_risk(tr)
    if (is.null(scorer)) return(NULL)
    tr$risk_score <- scorer(tr); te$risk_score <- scorer(te)
  }
  ## ① 训练窗定阈值（风险分的 q 分位）——★ 阈值也是被拟合的参数，绝不用全样本
  thr <- if (is.null(fixed_thr)) stats::quantile(tr$risk_score, q_thr, na.rm = TRUE)
         else fixed_thr
  ## ② 测试窗执行：命中者被处置
  te$hit <- te$risk_score >= thr
  hit <- te[te$hit, , drop = FALSE]; nor <- te[!te$hit, , drop = FALSE]
  if (!nrow(hit)) return(NULL)
  hold <- function(d) -sum(d$game_pnl, na.rm = TRUE) / pmax(sum(d$stake, na.rm = TRUE), 1e-9)
  ## ③ 收益侧：命中人群赢走的钱，按处置回收率折算（不假设 100% 回收）
  ##    net_pnl 为玩家口径：>0 玩家赢=平台漏，<0 玩家输=平台赚
  gross_recover <- pmax(sum(hit$net_pnl, na.rm = TRUE), 0) * action_recover
  ## ④ 成本侧：误伤——命中人群里本来在给平台赚钱的那些人，按流失系数折算损失
  good_hit  <- sum(hit$net_pnl < 0, na.rm = TRUE)
  misfire   <- sum(pmax(-hit$net_pnl, 0), na.rm = TRUE) * churn_cost
  net_gain  <- gross_recover - misfire            # ★ 可正可负，Sortino 才有意义
  tibble::tibble(
    折 = fold$fold,
    训练窗 = paste(fold$tr, collapse = " ~ "),
    测试窗 = paste(fold$te, collapse = " ~ "),
    ## 走势图的 X 轴用真实日期而非折序：折序看不出业务节律，日期才对得上经营日历。
    ## 取测试窗**结束日**为该折的时间坐标——该折的业绩到这一天才全部实现。
    测试起日 = as.Date(fold$te[1]),
    测试止日 = as.Date(fold$te[2]),
    阈值 = round(as.numeric(thr), 4),
    命中会员数 = nrow(hit),
    命中占比 = nrow(hit) / pmax(nrow(te), 1),
    命中组hold = hold(hit),
    对照组hold = hold(nor),
    hold差 = hold(hit) - hold(nor),
    毛回收 = gross_recover,
    误伤成本 = misfire,
    净增益 = net_gain,
    误伤数 = good_hit,
    误伤率 = good_hit / pmax(nrow(hit), 1))
}
prep_bt <- function(df) {
  x <- df |> dplyr::mutate(
    bet_date = as.Date(bet_date),
    dplyr::across(dplyr::any_of(c("risk_score","stake","game_pnl","net_pnl",
                                  "rebate","validbet","n_rounds","n_tables","n_ip",
                                  "late_share_d","hedge_rate_d","stake_cv_d")),
                  ~suppressWarnings(as.numeric(.x)))) |>
    dplyr::filter(!is.na(bet_date), is.finite(stake), stake > 0)
  x$roi_game_d <- x$game_pnl / pmax(x$stake, 1e-9)   # 日 ROI，风险分的一维
  x
}
```

```{r}
#| label: bench-engine
#| echo: true
## 给定一条策略的逐期净增益序列，与三条朴素基线并排评价
## 指标一次给全：均值 / 5%分位 / 夏普 / 索提诺 / 最大回撤 / 胜期占比 / MASE
bench_metrics <- function(x, rf = 0) {
  x <- x[is.finite(x)]
  if (!length(x)) return(NULL)
  cum <- cumsum(x); peak <- cummax(cum)
  dn  <- sqrt(mean(pmin(x - rf, 0)^2))
  list(n = length(x), mean = mean(x),
       q05 = as.numeric(stats::quantile(x, .05)),
       sharpe  = if (stats::sd(x) > 0) (mean(x) - rf) / stats::sd(x) else NA_real_,
       sortino = if (dn > 0) (mean(x) - rf) / dn else NA_real_,
       mdd = if (length(cum)) min(cum - peak) else NA_real_,
       win = mean(x > 0), total = sum(x))
}

## 与基线并排：strategy 与 baselines 均为同长度的逐期净增益向量
bench_vs <- function(strategy, baselines, labels = names(baselines)) {
  fmt <- function(m, nm) tibble::tibble(
    方案 = nm, 期数 = m$n,
    累计净增益 = round(m$total, 0), 均值 = round(m$mean, 0),
    `5%分位` = round(m$q05, 0),
    夏普率 = round(m$sharpe, 3), 索提诺率 = round(m$sortino, 3),
    最大回撤 = round(m$mdd, 0), 胜期占比 = scales::percent(m$win, accuracy = 0.1))
  rows <- list(fmt(bench_metrics(strategy), "★ 本方案策略"))
  for (i in seq_along(baselines))
    rows[[i + 1L]] <- fmt(bench_metrics(baselines[[i]]), labels[i])
  out <- dplyr::bind_rows(rows)
  base_mae <- mean(abs(baselines[[1]]), na.rm = TRUE)
  out$MASE <- c(round(mean(abs(strategy - baselines[[1]]), na.rm = TRUE) /
                        pmax(base_mae, 1e-9), 3),
                rep(NA_real_, length(baselines)))
  out$相对提升 <- scales::percent(
    out$累计净增益 / pmax(abs(out$累计净增益[2]), 1e-9) - 1, accuracy = 0.1)
  out
}
```

```{r}
#| label: bench-run
#| echo: false
COLS_BT2 <- c("member_id","bet_date","stake","game_pnl","net_pnl")
if (need_data(D$bt_panel, "策略回测", COLS_BT2)) guard({
  p <- prep_bt(D$bt_panel); folds <- purged_folds(p$bet_date)
  pfp <- .hash(list(nrow(p), names(p), .fp_input(p)))   # 面板指纹只算一次，供折级检查点复用
  res <- cached("bt_folds", version = "v1",
    inputs = list(p), params = list(q_thr = 0.99, recover = 0.60, churn = 0.15,
                                    train = BT_PARAMS$train, embargo = BT_PARAMS$embargo,
                                    test = BT_PARAMS$test, step = BT_PARAMS$step,
                                    mode = BT_PARAMS$mode),
    expr = map_dfr_pg(folds, function(f) fold_ckpt(p, f, pfp), label = "策略回测逐折"))
  if (!nrow(res)) {
    tibble::tibble(状态 = "无有效折") |> aurora_kb(caption = "基准对照")
  } else {
    ## 三条朴素基线，全部用同一批折、同一套经济口径
    b_none  <- rep(0, nrow(res))                      # ① 什么都不做
    b_mean  <- cached("bt_folds_mean", version = "v1",
      inputs = list(p), params = list(rule = "mean+3sd"),
      expr = map_dfr_pg(folds, function(f) {
        tr <- p[p$bet_date >= f$tr[1] & p$bet_date <= f$tr[2], , drop = FALSE]
        if (!nrow(tr)) return(NULL)
        sc <- fit_risk(tr); if (is.null(sc)) return(NULL)
        s0 <- sc(tr)
        fold_ckpt(p, f, pfp, fixed_thr = mean(s0, na.rm = TRUE) + 3 * stats::sd(s0, na.rm = TRUE))
      }, label = "基线·均值+3σ"))
    b_frozen <- cached("bt_folds_naive", version = "v1",
      inputs = list(p), params = list(fixed_thr = res$阈值[1], recover = 0.60, churn = 0.15),
      expr = map_dfr_pg(folds, function(f) fold_ckpt(p, f, pfp, fixed_thr = res$阈值[1]),
                        label = "基线·阈值冻结"))
    pad <- function(d) { v <- if (is.null(d) || !nrow(d)) numeric(0) else d$净增益
                         c(v, rep(0, max(0, nrow(res) - length(v))))[seq_len(nrow(res))] }
    bench_vs(res$净增益,
             list(`基线① 阈值冻结（不重估）` = pad(b_frozen),
                  `基线② 均值+3σ（教科书做法）` = pad(b_mean),
                  `基线③ 什么都不做` = b_none)) |>
      aurora_kb(caption = paste0(
        "本方案 vs 三条朴素基线（同折、同经济口径；MASE 以基线① 为分母，<1 才算真优）"))
  }
}, "策略回测") else ph_out("策略回测")
```

```{r}
#| label: bench-chart
#| fig-height: 4.6
#| echo: false
if (need_data(D$bt_panel, "策略回测", COLS_BT2)) guard({
  p <- prep_bt(D$bt_panel); folds <- purged_folds(p$bet_date)
  pfp <- .hash(list(nrow(p), names(p), .fp_input(p)))   # 面板指纹只算一次，供折级检查点复用
  res <- cached("bt_folds", version = "v1",
    inputs = list(p), params = list(q_thr = 0.99, recover = 0.60, churn = 0.15,
                                    train = BT_PARAMS$train, embargo = BT_PARAMS$embargo,
                                    test = BT_PARAMS$test, step = BT_PARAMS$step,
                                    mode = BT_PARAMS$mode),
    expr = map_dfr_pg(folds, function(f) fold_ckpt(p, f, pfp), label = "策略回测逐折"))
  if (!nrow(res)) {
    tibble::tibble(状态 = "无有效折") |> aurora_kb(caption = "走势图")
  } else {
    b_frozen <- cached("bt_folds_naive", version = "v1",
      inputs = list(p), params = list(fixed_thr = res$阈值[1], recover = 0.60, churn = 0.15),
      expr = map_dfr_pg(folds, function(f) fold_ckpt(p, f, pfp, fixed_thr = res$阈值[1]),
                        label = "基线·阈值冻结"))
    ## 第三条线：业内最朴素的做法「均值 + 3 倍标准差」。四方并排才回答得了
    ##   「不推行 / 推行本方案 / 用一般均值分析 / 只冻结阈值」之间的差别。
    b_mean <- cached("bt_folds_mean", version = "v1",
      inputs = list(p), params = list(rule = "mean+3sd"),
      expr = map_dfr_pg(folds, function(f) {
        tr <- p[p$bet_date >= f$tr[1] & p$bet_date <= f$tr[2], , drop = FALSE]
        if (!nrow(tr)) return(NULL)
        sc <- fit_risk(tr); if (is.null(sc)) return(NULL)
        s0 <- sc(tr)
        fold_ckpt(p, f, pfp, fixed_thr = mean(s0, na.rm = TRUE) + 3 * stats::sd(s0, na.rm = TRUE))
      }, label = "基线·均值+3σ"))
    mk <- function(d, nm) if (is.null(d) || !nrow(d)) NULL else
      tibble::tibble(折 = d$折, 方案 = nm, 净增益 = d$净增益, 测试窗 = d$测试窗,
                     测试止日 = d$测试止日,
                     误伤率 = d$误伤率, 阈值 = d$阈值, 命中会员数 = d$命中会员数)
    dd <- dplyr::bind_rows(
      mk(res, "★ 本方案（赏罚分明）"),
      mk(b_mean,   "一般均值分析（均值+3σ）"),
      mk(b_frozen, "阈值冻结（不重估）"),
      tibble::tibble(折 = res$折, 方案 = "不推行赏罚（现状）", 净增益 = 0,
                     测试窗 = res$测试窗, 测试止日 = res$测试止日,
                     误伤率 = 0, 阈值 = NA_real_,
                     命中会员数 = 0L)) |>
      dplyr::group_by(方案) |> dplyr::arrange(折, .by_group = TRUE) |>
      dplyr::mutate(累计净增益 = cumsum(净增益),
                    回撤 = 累计净增益 - cummax(累计净增益)) |> dplyr::ungroup()
    g <- ggplot2::ggplot(dd, ggplot2::aes(测试止日, 累计净增益, colour = 方案,
           group = 方案,
           text = paste0(format(测试止日, "%Y-%m-%d"), "　", 方案,
                         "<br>测试窗：", 测试窗,
                         "<br>命中会员：", format(命中会员数, big.mark = ","),
                         "<br>本折净增益：", format(round(净增益, 0), big.mark = ","),
                         "<br>累计净增益：", format(round(累计净增益, 0), big.mark = ","),
                         "<br>回撤：", format(round(回撤, 0), big.mark = ","),
                         "<br>误伤率：", scales::percent(误伤率, accuracy = .1),
                         "<br>本折阈值：", round(阈值, 3),
                         "<br>———",
                         "<br>净增益 = 回收(命中者净赢×60%) − 误伤成本(好客净贡献×15%)"))) +
      ggplot2::geom_hline(yintercept = 0, colour = PAL$warn, linetype = 2) +
      ggplot2::geom_line(linewidth = 1) + ggplot2::geom_point(size = 2) +
      ggplot2::scale_colour_manual(values = c(PAL$good, PAL$accent, PAL$violet, PAL$warn)) +
      ## X 轴：测试窗结束日，按月标注，读者可直接对上经营日历
      ## X 轴：每月一格并标出完整日期，读者可直接对上经营月历
      ggplot2::scale_x_date(date_breaks = "1 month", date_labels = "%Y-%m-%d",
                            date_minor_breaks = "1 week") +
      ## Y 轴：金额千分位。ggplot 默认会把千万级金额显示成 2e+07，业务方读不了
      ggplot2::scale_y_continuous(labels = scales::comma_format(accuracy = 1)) +
      ggplot2::theme(axis.text.x = ggplot2::element_text(angle = 30, hjust = 1)) +
      ggplot2::labs(title = "累计净增益走势：四种情形并排",
                    subtitle = paste0("★ 本方案（赏罚分明）　vs　一般均值分析（均值+3σ）　vs　",
                                      "阈值冻结（不重估）　vs　不推行赏罚（恒为 0）；",
                                      "悬停任一点可见该折全部指标与累计净增益的构成式"),
                    caption = NULL,   # 释义改由图下一行 ⓘ 悬停给出，不占版面
                    x = "测试窗结束日", y = "累计净增益（金额）")
    if (HAS[["plotly"]]) {
      ## ★ ggplotly 转换出来的图同样沿用 plotly 默认浅底悬浮框，
      ##   必须再套一层 HOVER，否则本图重蹈「浅底浅字读不出」的覆辙。
      plotly::ggplotly(g, tooltip = "text") |>
        plotly::layout(hoverlabel = HOVER,
                       paper_bgcolor = "rgba(0,0,0,0)",
                       plot_bgcolor  = "rgba(0,0,0,0)",
                       font = list(color = PAL$fg))
    } else g
  }
}, "策略回测") else ph_out("策略回测")
```

::: {.callout-note}
## 这张走势图怎么读，以及它在本方案里回答什么

**四条线各代表一种经营选择**，跑在同一批净化折、同一套经济口径上，可直接比较：

| 线 | 代表的经营选择 | 阈值怎么来 |
|---|---|---|
| ★ 本方案（赏罚分明） | 每折用训练窗重新估阈值，测试窗只执行不调参 | 训练窗风险分的 P99 |
| 一般均值分析（均值+3σ） | 教科书做法：以均值加三倍标准差划线 | 训练窗风险分的 μ+3σ |
| 阈值冻结（不重估） | 定一次阈值就一直用，不随时间重估 | 首折阈值，此后不变 |
| 不推行赏罚（现状） | 什么都不做，是所有比较的零基线 | 无 |

**X 轴是测试窗结束日**，不是折序——该折的业绩到这一天才全部实现，用日期才对得上
经营日历与季节性。**Y 轴是累计净增益的金额**，千分位显示。

**净增益的构成**：命中人群净赢金额 × 回收率 60%，减去误伤成本（命中人群里本来
在给平台赚钱的那些人，其净贡献 × 流失系数 15%）。**两类错误都已折成钱算进去了**，
所以这条线可以直接读作「这套方案净赚多少」，不需要另外扣减。

**怎么判断本方案是否真的更优**：看三件事，缺一不可——① 本方案的线是否稳定高于
其余三条；② 回撤（悬停可见）是否可接受；③ @sec-benchmark 的 MASE 是否小于 1
（以阈值冻结为分母，小于 1 才算真优）。**只看终点高低会被单折的运气骗到。**

**防未来数据的三道纪律**：阈值只在训练窗估、训练与测试之间留 7 天禁运期、
风险分本身也只在训练窗拟合（`B-01` 导出刻意不含 `risk_score`，就是为了杜绝
在 SQL 里用全量算好分数再回测这种最隐蔽的泄漏）。
:::

## 训练窗长的嵌套选择：窗长是超参数，由数据定，不由人拍 {#sec-window-grid}

「用多少天训练最准」没有先验答案。候选一律取 **7 的整倍数**（流水有强烈星期节律，
非整周窗长会让各折训练窗的周中/周末构成随折漂移）；选择程序必须**嵌套**——
只在前段（选窗段，前 104 天）比较候选、锁定后在剩余时段（OOT 段）确认，
用全窗既选又报成绩就是 Deflated 意义上的选择泄漏。
候选 91 天在 104 天选窗段内切不出一个完整折，**如实标注「样本不足」而不硬评**。

```{r}
#| label: bench-window-grid
#| echo: false
if (need_data(D$bt_panel, "策略回测", COLS_BT2)) guard({
  p <- prep_bt(D$bt_panel)
  pfp <- .hash(list(nrow(p), names(p), .fp_input(p)))
  d0 <- min(p$bet_date, na.rm = TRUE); dN <- max(p$bet_date, na.rm = TRUE)
  sel_end <- d0 + 103                       # 选窗段：前 104 天（= GRID_PAR$sel_days）
  grid <- c(28, 42, 56, 63, 91)
  ## 网格切分参数的单一权威：表题、实算与缓存指纹同源
  GRID_PAR <- list(sel_days = 104, embargo = 7, test = 7, step = 7)
  gw <- cached("bt_window_grid", version = "v1",
    inputs = list(p),
    params = c(list(grid = grid), GRID_PAR),
    expr = {
      eval_T <- function(T, dates_hi, lo_gate = NULL) {
        fs <- purged_folds(p$bet_date[p$bet_date <= dates_hi], train = T,
                           embargo = GRID_PAR$embargo, test = GRID_PAR$test,
                           step = GRID_PAR$step, mode = "sliding")
        if (!is.null(lo_gate)) fs <- Filter(function(f) f$te[1] > lo_gate, fs)
        if (!length(fs)) return(NULL)
        r <- map_dfr_pg(fs, function(f) fold_ckpt(p, f, pfp),
                        label = paste0("窗长网格 T=", T))
        if (is.null(r) || !nrow(r)) return(NULL)
        tibble::tibble(折数 = nrow(r),
          净增益P5   = stats::quantile(r$净增益, .05, na.rm = TRUE),
          净增益中位 = stats::median(r$净增益, na.rm = TRUE),
          误伤率中位 = stats::median(r$误伤率, na.rm = TRUE))
      }
      sel <- lapply(grid, function(T) {
        m <- eval_T(T, sel_end)
        if (is.null(m)) tibble::tibble(训练窗 = T, 段 = "选窗段",
               折数 = 0L, 净增益P5 = NA, 净增益中位 = NA, 误伤率中位 = NA,
               备注 = "选窗段内切不出完整折——样本不足，不参与评选")
        else dplyr::bind_cols(tibble::tibble(训练窗 = T, 段 = "选窗段"), m,
                              tibble::tibble(备注 = ""))
      }) |> dplyr::bind_rows()
      ok <- sel[sel$折数 > 0, , drop = FALSE]
      Tstar <- if (nrow(ok)) ok$训练窗[order(-ok$净增益P5, -ok$训练窗)][1] else 63
      oot <- eval_T(Tstar, dN, lo_gate = sel_end)
      list(sel = sel, Tstar = Tstar,
           oot = if (is.null(oot)) NULL else
             dplyr::bind_cols(tibble::tibble(训练窗 = Tstar, 段 = "OOT 确认段"),
                              oot, tibble::tibble(备注 = "以选窗段冠军跨期外确认")))
    })
  tab <- dplyr::bind_rows(gw$sel, gw$oot) |>
    dplyr::mutate(dplyr::across(dplyr::where(is.numeric), ~round(.x, 2)))
  oo <- gw$oot
  verdict <- if (is.null(oo)) "OOT 段切不出完整折，窗长选择暂以选窗段为准，正式窗长维持 63。"
    else if (is.finite(oo$净增益P5) && oo$净增益P5 > 0)
      paste0("选窗段冠军 T*=", gw$Tstar, "，且在 OOT 段 净增益P5 > 0 —— 窗长选择在样本外站得住。")
    else paste0("选窗段冠军 T*=", gw$Tstar, "，但 OOT 段 P5 未过 0 —— 判「未能证实更优」，正式窗长维持 63。")
  ## ★ kable 的返回值本身就是 HTML，直接交给 knitr 输出即可。
  ##   旧版包进 list() 再 htmltools::tagList()，标签被当成纯文本转义，
  ##   页面上于是印出整段 <table class="table ..."> 源码而非表格。
  aurora_kb(tab, caption = paste0(
    "训练窗长嵌套选择（选窗段=前 ", GRID_PAR$sel_days, " 天 · OOT=其后；测试窗 ",
    GRID_PAR$test, " 日 · 步长 ", GRID_PAR$step, " 日 · 禁运 ", GRID_PAR$embargo,
    " 日）——", verdict,
    "｜解释：把「用多少天训练」当成一个待定参数，先只在前段逐个候选试算，",
    "锁定后再到后段独立复核",
    "｜本方案用途：确保训练天数由数据选出并经跨期复核，而非人为指定"))
}, "策略回测") else ph_out("策略回测")
```

::: {.callout-warning}
本节结论只回答「窗长」这一个超参数。主协议（63 天滑动 · 禁运 7 · 测试 14）
不随本表自动改动——**只有 OOT 段 P5 显著优于 63 天时才换**，且换窗须记入
@sec-changelog 并整段重跑。选窗段与 OOT 段共用折级检查点，本节的边际计算成本
接近零。
:::

::: {.callout-important}
## 误判概率与损失：把两类错误分开算钱

风控的错有两种，代价完全不同：

| | 含义 | 代价 | 本方案怎么控 |
|---|---|---|---|
| **误伤（假阳性）** | 好客人被当成风险 | 赔掉**终身价值** $\text{NC}_i\times H_i$，且可能引发客诉与口碑损失 | 四闸之③：误伤率中位 ≤ 该动作层的现算上限；处置一律先走结算侧不动账户 |
| **漏放（假阴性）** | 套利团伙没抓到 | 赔掉**当期漏损**（退水 + 占成 − 该群 GGR） | 三闸漏斗保召回；T4 扩样排队复核 |

回测里的**净增益**已经把两者一起算进去了：

$$\text{净增益}=\underbrace{\max(\textstyle\sum\text{命中者净赢},0)\times\text{回收率}}_{\text{抓到的钱}}
-\underbrace{\textstyle\sum\max(-\text{净赢},0)\times\text{流失系数}}_{\text{误伤赔的钱}}$$

**这就是为什么净增益可正可负**——只有它能为负，索提诺与最大回撤才有意义。
只报「抓到多少」不报「误伤赔多少」的方案，本报告一律判为不可上线。
:::

---

# 商业方案的滚动回测：在净化纪律下结算其潜在增益 {#sec-strategy-bt}

> 需求原话：**「务必使用滚动回测来进行实验证实商业方案可行。」**
>
> 注意这里回测的对象**不是模型 AUC**，而是**商业方案本身**：
> 「按阈值 X 命中人群、执行动作 Y」这一整套，在下一段时间里
> **到底把平台的净贡献抬高了多少**。AUC 高而不能盈利的模型，本报告一律不上线。

::: {.callout-important}
## 本章结论的性质：决策模拟，不是已发生的现金

本章章题原作「证明其确能盈利」，**此一表述已越界，今予收回**。理由须讲清楚：

平台**无处置日志**（见 @sec-limit 与 SQL 总包 §EX-01 的实测结论）——即没有任何一条记录能证明
「限红、冻结算、追佣金」这些动作**真的执行过**。既然动作未曾发生，回测所算出的净增益，
其性质只能是「**若当时照此处置，账面会如何**」，即**决策模拟（Decision Simulation）**，
**不是已实现的利润**。

故本章一切金额的正确读法是：**在净化滚动回测下，该商业方案给出的潜在增益区间**；
实际盈亏另取决于三件本报告尚未取到的东西——处置执行率、追缴回收率、误伤流失系数。
本章末的验收表已逐项标明其位置。凡对外引用本章数字，须连同这一条一并给出。
:::

## 一、回测协议（与模型竞技场同一套净化纪律）

```{r}
#| label: bt-protocol
#| echo: false
## 设置一栏一律由 BT_PARAMS 与实际面板现算，不写死数字——改参数即同步。
BT_AXIS <- if (!is.null(D$bt_panel) && is.data.frame(D$bt_panel) &&
               "bet_date" %in% names(D$bt_panel)) {
  dt <- as.Date(D$bt_panel$bet_date); dt <- dt[!is.na(dt)]
  ## ★ 营业日向量在此一并留存（139 个日期，内存可忽略）。
  ##   缘由：D$bt_panel 于 @sec-roster 之后即 release()，其后的折结构体检若再取该表，
  ##   拿到的是已释放的 NULL，遂误报「待数据」——而数据其实早已就位。
  ##   本方案的依赖纪律是「release() 须晚于最后一次使用」；跨越释放点的后续章节
  ##   一律改用此处留存的轻量派生物，不得回头取大表。
  WF_DAYS <<- sort(unique(dt))
  list(n = length(unique(dt)), lo = min(dt), hi = max(dt),
       folds = length(purged_folds(dt)))
} else list(n = NA_integer_, lo = NA, hi = NA, folds = NA_integer_)
tibble::tribble(
  ~环节, ~设置, ~为什么这么设,
  "时间轴",
    if (is.na(BT_AXIS$n)) "⬜ 待 B01_bt_panel.csv（SQL 总包 §B01）就位后现算"
    else glue::glue("{BT_AXIS$n} 营业日（{BT_AXIS$lo} ~ {BT_AXIS$hi}）"),
    "E1 全局窗口，禁用任何局部窗口",
  "训练窗", glue::glue("{BT_PARAMS$train} 日"), "足够估出阈值分位，又不至于覆盖整段",
  "净化 Purge","跨切点的**整个物理局**剔除","同一局横跨切点会把测试期信息带进训练期",
  "禁运 Embargo", glue::glue("{BT_PARAMS$embargo} 日"),
    "注单结算与人工标记有滞后，7 日覆盖绝大部分回填",
  "测试窗", glue::glue("{BT_PARAMS$test} 日"), "一个结算周期，与业务复核节奏对齐",
  "滚动步长", glue::glue("{BT_PARAMS$step} 日"),
    if (is.na(BT_AXIS$folds)) "候选一律取 7 的整倍数；折数待面板就位后现算"
    else glue::glue("候选一律取 7 的整倍数；本次面板可切出 {BT_AXIS$folds} 折"),
  "阈值来源","**只用训练窗数据的分位数**","阈值本身也是被拟合的参数，用全样本定阈值就是泄漏",
  "风险分来源","**经验分位函数只在训练窗拟合**，再原样套到测试窗","B-01 导出刻意不含 risk_score——在 SQL 里用全量算好分数是最隐蔽的一种泄漏",
  "基线 Naive","不做任何处置，维持现状","MASE 的分母；跑不赢它就没有上线的理由"
) |> aurora_kb(caption="策略滚动回测协议（Purged Walk-Forward，[López de Prado 口径](https://doi.org/10.1002/9781119482086)）｜设置一栏于本次渲染现算")
```

::: {.callout-warning}
## 最容易被忽略的一条：**阈值也要放进训练窗里估**

见过太多「回测很好看」的方案，问题都出在同一个地方：
阈值（比如「同桌率 ≥30%」「Z ≥ 3.2」）是**看着全量数据挑出来的**，
然后拿全量数据回测。这不是回测，这是自我印证。

本协议强制：**每一折的阈值，只能由该折训练窗的分位数算出**，
然后原封不动搬到测试窗执行。折间阈值会漂——**这正是要看的东西**：
阈值若在折间剧烈跳动，说明它不稳定，不能上线。
:::

## 二、回测引擎

::: {.callout-note}
## 回测引擎在哪里定义

`purged_folds()`（净化折切分）、`fit_risk()`（训练窗风险分拟合）、
`bt_fold()`（单折评估）、`prep_bt()`（面板预处理）四个函数的完整定义，
统一放在 @sec-benchmark 的 `engine-core` 代码块。

本章与 @sec-benchmark **共用同一份定义**：两章的回测必须口径一致，
否则「本方案 vs 基准线」的比较就不成立。想改回测协议——折长、禁运期、
阈值分位、回收率、流失系数——只改 `engine-core` 一处，两章同步生效。
:::

```{r}
#| label: bt-run
#| echo: false
COLS_BT <- c("member_id","bet_date","stake","game_pnl","net_pnl")
if (need_data(D$bt_panel, "策略回测", COLS_BT)) guard({
  p <- prep_bt(D$bt_panel)
  folds <- purged_folds(p$bet_date)
  pfp <- .hash(list(nrow(p), names(p), .fp_input(p)))   # 面板指纹只算一次
  if (!length(folds)) {
    tibble::tibble(状态 = "时间跨度不足",
      说明 = "至少需要 63+7+14 = 84 个营业日才能切出一折") |>
      aurora_kb(caption = "策略滚动回测")
  } else {
    res <- cached("bt_folds", version = "v1",
      inputs = list(p), params = list(q_thr = 0.99, recover = 0.60, churn = 0.15,
                                      train = BT_PARAMS$train, embargo = BT_PARAMS$embargo,
                                    test = BT_PARAMS$test, step = BT_PARAMS$step,
                                    mode = BT_PARAMS$mode),
      expr = map_dfr_pg(folds, function(f) fold_ckpt(p, f, pfp), label = "策略回测逐折"))
    if (!nrow(res)) {
      tibble::tibble(状态 = "各折样本不足") |> aurora_kb(caption = "策略滚动回测")
    } else {
      res |> dplyr::mutate(
        命中占比 = scales::percent(命中占比, accuracy = 0.01),
        命中组hold = scales::percent(命中组hold, accuracy = 0.01),
        对照组hold = scales::percent(对照组hold, accuracy = 0.01),
        hold差   = scales::percent(hold差, accuracy = 0.01),
        误伤率   = scales::percent(误伤率, accuracy = 0.1),
        毛回收   = round(毛回收, 0),
        误伤成本 = round(误伤成本, 0),
        净增益   = round(净增益, 0)) |>
        aurora_kb(caption = "策略滚动回测 · 逐折明细（阈值由各折训练窗独立给出；净增益 = 毛回收 − 误伤成本）")
    }
  }
}, "策略回测") else ph_out("策略回测")
```

```{r}
#| label: bt-verdict
#| echo: false
if (need_data(D$bt_panel, "策略回测", COLS_BT)) guard({
  p <- prep_bt(D$bt_panel)
  folds <- purged_folds(p$bet_date)
  pfp <- .hash(list(nrow(p), names(p), .fp_input(p)))   # 面板指纹只算一次
  ## 与上一块同 key 同参数 → 必然命中缓存，同一份逐折结果不会算两遍
  res <- cached("bt_folds", version = "v1",
    inputs = list(p), params = list(q_thr = 0.99, recover = 0.60, churn = 0.15,
                                    train = BT_PARAMS$train, embargo = BT_PARAMS$embargo,
                                    test = BT_PARAMS$test, step = BT_PARAMS$step,
                                    mode = BT_PARAMS$mode),
    expr = map_dfr_pg(folds, function(f) fold_ckpt(p, f, pfp), label = "策略回测逐折"))
  if (!nrow(res)) {
    tibble::tibble(状态 = "无有效折") |> aurora_kb(caption = "上线裁定")
  } else {
    ## ★ 朴素基线：阈值冻结在第一折，之后不再重估。
    ##   「重新估阈值」这件事本身有没有价值，只能靠它回答。
    thr0  <- res$阈值[1]
    naive <- cached("bt_folds_naive", version = "v1",
      inputs = list(p), params = list(fixed_thr = thr0, recover = 0.60, churn = 0.15),
      expr = map_dfr_pg(folds, function(f) fold_ckpt(p, f, pfp, fixed_thr = thr0),
                        label = "朴素基线逐折"))
    set.seed(20260807)
    bs <- replicate(2000, mean(sample(res$净增益, nrow(res), replace = TRUE)))
    ci <- stats::quantile(bs, c(.05, .5, .95), na.rm = TRUE)
    pos_share <- mean(res$hold差 < 0, na.rm = TRUE)   # hold差<0 = 命中组确实在吃庄家
    ## MASE 口径：策略净增益的绝对误差 ÷ 朴素基线的绝对误差（<1 才算跑赢朴素）
    mase <- if (nrow(naive) && mean(abs(naive$净增益), na.rm = TRUE) > 0)
              mean(abs(res$净增益 - naive$净增益[seq_len(nrow(res))]), na.rm = TRUE) /
              mean(abs(naive$净增益), na.rm = TRUE) else NA_real_
    lift <- if (nrow(naive) && abs(mean(naive$净增益, na.rm=TRUE)) > 0)
              mean(res$净增益, na.rm=TRUE) / mean(naive$净增益, na.rm=TRUE) else NA_real_
    ## 索提诺：分母只罚下行（净增益为负的折），正是「亏钱的折有多痛」
    sortino <- { rr <- res$净增益; dn <- sqrt(mean(pmin(rr, 0)^2, na.rm = TRUE))
                 if (is.finite(dn) && dn > 0) mean(rr, na.rm=TRUE)/dn else NA_real_ }
    gate <- c(
      `① 折间一致性：≥70% 折中命中组 hold 低于对照` = pos_share >= 0.70,
      `② 净增益均值的 5% 分位 > 0`                  = ci[[1]] > 0,
      `③ 误伤率中位 ≤ L4 现算上限` =
        stats::median(res$误伤率, na.rm = TRUE) <= FP_CEIL_L4,
      `④ 阈值折间变异系数 ≤ 30%`                    =
        (stats::sd(res$阈值, na.rm=TRUE)/pmax(abs(mean(res$阈值, na.rm=TRUE)),1e-9)) <= 0.30)
    verdict <- if (all(gate)) "🟢 **四闸全过 → 可进 P3 随机对照试运行**"
               else "🔴 **未全过 → 不上线**，逐项补齐后重测（见上表 ❌ 项）"
    tibble::tibble(
      判据 = c(names(gate), "折数", "净增益均值", "5%分位", "95%分位",
               "朴素基线净增益均值（阈值冻结）", "相对朴素提升倍数（>1 才有价值）",
               "MASE（<1 才优于朴素）", "索提诺比率（只罚下行）", "**最终裁定**"),
      结果 = c(ifelse(gate, "✅ 通过", "❌ 未过"),
               as.character(nrow(res)),
               format(round(mean(res$净增益, na.rm=TRUE), 0), big.mark = ","),
               format(round(ci[[1]], 0), big.mark = ","),
               format(round(ci[[3]], 0), big.mark = ","),
               if (nrow(naive)) format(round(mean(naive$净增益, na.rm=TRUE), 0), big.mark = ",") else "—",
               if (is.na(lift)) "—" else format(round(lift, 3), nsmall = 3),
               if (is.na(mase)) "—" else format(round(mase, 3), nsmall = 3),
               if (is.na(sortino)) "—" else format(round(sortino, 3), nsmall = 3),
               verdict)) |>
      aurora_kb(caption = "上线裁定 · 四闸判据（2,000 次自助重抽；任一未过即不上线）")
  }
}, "策略回测") else ph_out("策略回测")
```

::: {.callout-important}
## 四闸的设计意图（为什么是这四条）

| 闸 | 防的是什么 |
|---|---|
| ① 折间一致性 ≥70% | 防「一折暴赚、四折微亏」的均值假象 |
| ② 5% 分位 > 0 | 防用均值为正就上线——那是赌运气不是风控 |
| ③ 误伤率 ≤ **动作层现算上限** | 防为了抓坏人把好客人一起罚了。**误伤一个 V1 的代价远高于漏放一个 R1**。上限不写死，按动作层以成本敏感准则现算——详见下节 |
| ④ 阈值变异系数 ≤ 30% | 防阈值本身不稳定——今天 0.9 明天 0.5，上线后没法运维 |

四闸任一不过，**方案退回、不上线**。这条纪律不接受「先上再调」。
:::

## 误伤上限按动作分层 {#sec-fp-tier}

统一一个误伤率上限，对轻处置过严、对重处置过宽，两头都不对。**上限应由动作的代价结构导出，
不由经验数字指定。** 对某人采取动作 $a$，设其确为风险者的概率为 $p$，则该动作的期望净值为

$$\mathrm{EV}(a) = p\,g(a)\,W \;-\; (1-p)\,c(a)\,H(a)\,L$$

其中 $W$ 为该人赢走额、$L$ 为其输掉额，$g$ 为挽回系数、$c$ 为流失系数、
$H$ 为误伤所毁掉的期数（终身价值折算倍数）。令 $\mathrm{EV}\ge 0$，解得可容忍的误伤率上限

$$f^{*}(a) \;=\; \frac{g\,W}{g\,W + c\,H\,L}$$

此即成本敏感准则（Elkan 2001）在处置场景下的直接应用：**动作越重，$H$ 越大、上限越低**；
观察类动作无处置代价，上限不适用。

```{r}
#| label: fp-tier
#| echo: false
## 赢输额之比 W/L：有回测结果时取实测，否则取 1（等量假设）并在表内注明
FP_WL <- if (exists("BT_WL") && is.finite(BT_WL) && BT_WL > 0) BT_WL else 1
FP_TAB <- ACT_TIER
FP_TAB$`误伤上限 f*` <- fp_ceiling(FP_TAB$g, FP_TAB$c, FP_TAB$H, FP_WL)
FP_TAB$`与统一 20% 之比较` <- ifelse(
  is.na(FP_TAB$`误伤上限 f*`), "无处置代价，上限不适用",
  ifelse(FP_TAB$`误伤上限 f*` > 0.20,
         sprintf("20%% 偏严，安全边际 %.1f 倍", FP_TAB$`误伤上限 f*` / 0.20),
         sprintf("⚠ 20%% 已越过盈亏平衡（%.1f%%）", 100 * FP_TAB$`误伤上限 f*`)))
FP_TAB$`误伤上限 f*` <- ifelse(is.na(FP_TAB$`误伤上限 f*`), "—",
                               sprintf("%.1f%%", 100 * FP_TAB$`误伤上限 f*`))
names(FP_TAB) <- c("动作层", "本层动作", "挽回系数 g", "流失系数 c",
                   "误伤毁掉期数 H", "误伤上限 f*", "与统一 20% 之比较")
aurora_kb(FP_TAB, caption = paste0(
  "误伤上限按动作分层（W/L = ", format(round(FP_WL, 2), nsmall = 2),
  if (exists("BT_WL")) "，实测" else "，等量假设",
  "）｜解释：f* 为该动作层在期望净值不为负的前提下可容忍的最大误伤率",
  "｜本方案用途：四闸之③的判据取本次回测所模拟的 L4 层现算值，不写死统一数"))
```

**读法**：现行统一的 20%，对 L2 至 L4 三层皆偏严——其中 L4 结算侧处置的盈亏平衡点为 50%，
20% 尚留 2.5 倍安全边际；而对 **L5 账户侧处置（冻结结算、追缴）则已越过盈亏平衡点 17.6%**，
即按 20% 放行，冻结与追缴的期望净值为负。故上限必须分层，一个数管到底两头都错。

::: {.callout-important}
## 本表三个系数的性质：情景参数，非模型估计

$g$、$c$、$H$ 与经济增益模型中的回收率、流失系数同属**情景参数**，由业务判断给定，
尚未由任何实际处置历史估出——因平台**无处置台账**（§EX-01 实测已证）。
故本表回答的是「若各层的代价结构如此，则上限应为几何」，
**不回答「实际误伤一个客人要赔多少」**。三系数的真值须待处置台账到位后重估；
在此之前，L5 账户侧处置一律须经人工复核逐案确认，不得由分数直接触发。
:::

---

# 四实体赏罚名录与业绩增幅 {#sec-roster}

> 本章把 @sec-radar 的评分设计落到**名单**上：本窗口内所有下注玩家、荷官、代理与
> 风控专员，按各自综合分排出该赏、该罚与观察三档，并给出这套赏罚在回测里对应的
> 业绩增幅。分档线不由人指定，取各实体自身综合分的分位点（该赏 ≥P95、该罚 ≤P5），
> 随数据变动。

```{r}
#| label: roster-tiers
#| echo: false
## 名录一律读 @sec-radar 现场落盘的评分件（数据库/_scored_{实体}.csv），
## 不另起一套口径；文件由该章在本次渲染中写出，故此处必与雷达同源。
ROSTER_ENT <- c("玩家", "荷官", "代理", "风控专员")
ROSTER <- lapply(ROSTER_ENT, function(e) {
  r <- resolve_csv(paste0("_scored_", e))
  if (is.na(r$path)) return(NULL)
  x <- guard(read_any(r$path), paste0("名录·", e))
  if (is.null(x) || !"综合分" %in% names(x)) return(NULL)
  x$综合分 <- suppressWarnings(as.numeric(x$综合分))
  x <- x[is.finite(x$综合分), , drop = FALSE]
  if (!nrow(x)) return(NULL)
  ## ★ 小样本护栏：在册人数不足 MIN_N 时，P95 与 P5 会挤在一起甚至互相跨越，
  ##   同一人可能同时满足两侧条件——风控专员仅 6 人即属此列。此时一律不分档，
  ##   全员记「观察（样本不足）」，并如实说明所待数据，绝不以无意义的分位切名单。
  MIN_N <- 20L
  if (nrow(x) < MIN_N) {
    x$赏罚 <- "观察（样本不足）"
    return(list(实体 = e, tab = x, hi = NA_real_, lo = NA_real_,
                path = r$path, 分档 = FALSE, n_min = MIN_N))
  }
  hi <- stats::quantile(x$综合分, .95, na.rm = TRUE)
  lo <- stats::quantile(x$综合分, .05, na.rm = TRUE)
  ## 归属唯一：先判该赏，未入该赏者才判该罚，杜绝一人两档
  x$赏罚 <- ifelse(x$综合分 >= hi, "该赏",
             ifelse(x$综合分 <= lo & x$综合分 < hi, "该罚", "观察"))
  list(实体 = e, tab = x, hi = hi, lo = lo, path = r$path, 分档 = TRUE, n_min = MIN_N)
})
names(ROSTER) <- ROSTER_ENT
ROSTER <- Filter(Negate(is.null), ROSTER)
if (!length(ROSTER)) {
  tibble::tibble(
    状态 = "⬜ 待数据",
    所待文件 = "数据库/_scored_玩家.csv 等四份（由 @sec-radar 于本次渲染写出；其前置为 S01~S04 四份评分底料，SQL 总包 §06 S-01~S-03 与 §S04p）",
    受影响输出 = "本章全部名录、分档计数与业绩增幅") |>
    aurora_kb(caption = paste0("四实体赏罚名录（待评分件）",
      "｜解释：名录取自评分章现场落盘的评分件",
      "｜本方案用途：评分件到位后本章自动出全量分档"))
} else {
  dplyr::bind_rows(lapply(ROSTER, function(z) {
    x <- z$tab
    tibble::tibble(
      实体 = z$实体,
      在册人数 = format(nrow(x), big.mark = ","),
      该赏线 = if (z$分档) round(z$hi, 3) else NA_real_,
      该罚线 = if (z$分档) round(z$lo, 3) else NA_real_,
      该赏人数 = format(sum(x$赏罚 == "该赏"), big.mark = ","),
      观察人数 = format(sum(grepl("^观察", x$赏罚)), big.mark = ","),
      该罚人数 = format(sum(x$赏罚 == "该罚"), big.mark = ","),
      综合分中位 = round(stats::median(x$综合分), 3),
      备注 = if (z$分档) "" else
        glue::glue("在册 {nrow(x)} 人不足 {z$n_min} 人，分位分档无统计意义，本次不分档；",
                   "所待数据：风控处置日志与申诉记录（本方案尚无此两表），到位后按 §S04p 扩编重导"))
  })) |>
    aurora_kb(caption = paste0(
      "四实体赏罚分档（分档线取各实体综合分的 P95 / P5，本次渲染现算）",
      "｜解释：在册人数按评分件行数计，该赏与该罚人数按各自分档线切出",
      "｜本方案用途：直接给出每一类对象里该奖励、该观察、该处置各有多少人，",
      "是排班、返水与调查资源分配的依据"))
}
```

```{r}
#| label: roster-list
#| echo: false
## 全量名单在 数据库/_scored_{实体}.csv 内逐行可查；网页内嵌全量会令浏览器不堪负荷，
## 故此处按分档各取两端各 100 名可检索呈现，并注明全量文件与行数。
if (length(ROSTER)) {
  ## ★ 名单一律**按实际分档筛选**后再取两端：旧版不看分档、直接取综合分两端各 100，
  ##   在册人数不足 200 的实体两端必然重叠，同一对象遂既列该赏又列该罚。
  top <- dplyr::bind_rows(lapply(ROSTER, function(z) {
    x <- z$tab
    idc0 <- intersect(c("member_id","dealer_id","agent_id","uid","分析员","analyst"), names(x))
    idc0 <- if (length(idc0)) idc0[1] else names(x)[1]
    ## 未分档实体（在册不足 20 人）**照样列出全员**，但只有一档「观察（样本不足）」，
    ## 每人恰好一行——既不遗漏风控专员，也不可能一人两档。
    if (!z$分档) {
      o0 <- x[order(-x$综合分), , drop = FALSE]
      return(tibble::tibble(实体 = z$实体, 赏罚 = "观察（样本不足）",
                            对象 = as.character(o0[[idc0]]),
                            综合分 = round(o0$综合分, 3)))
    }
    idc <- intersect(c("member_id","dealer_id","agent_id","uid","分析员","analyst"), names(x))
    idc <- if (length(idc)) idc[1] else names(x)[1]
    o <- x[x$赏罚 == "该赏", , drop = FALSE]; o <- o[order(-o$综合分), , drop = FALSE]
    u <- x[x$赏罚 == "该罚", , drop = FALSE]; u <- u[order(u$综合分), , drop = FALSE]
    dplyr::bind_rows(
      if (nrow(o)) tibble::tibble(实体 = z$实体, 赏罚 = "该赏",
                     对象 = as.character(utils::head(o[[idc]], 100)),
                     综合分 = round(utils::head(o$综合分, 100), 3)),
      if (nrow(u)) tibble::tibble(实体 = z$实体, 赏罚 = "该罚",
                     对象 = as.character(utils::head(u[[idc]], 100)),
                     综合分 = round(utils::head(u$综合分, 100), 3)))
  }))
  stopifnot(!any(duplicated(paste(top$实体, top$对象))))   # 一人一档，重复即中断
  files <- paste(vapply(ROSTER, function(z)
    glue::glue("{basename(z$path)}（{format(nrow(z$tab), big.mark=',')} 行）"),
    character(1)), collapse = "；")
  top |> aurora_dt(caption = paste0(
    "赏罚名录（每类实体两端各 100 名，可检索分页）｜全量名单见 ", files,
    "｜解释：对象一栏为该实体在评分件中的标识，综合分为赏项均值减罚项均值",
    "｜本方案用途：该赏者进返水与礼遇名单，该罚者进调查与限额名单，逐个可追溯"), len = 20)
} else invisible(NULL)
```

```{r}
#| label: roster-uplift
#| echo: false
## 业绩增幅：以回测逐折净增益合计对同期投注与 GGR 取比，全部现算。
## 净增益 = 回收(命中者净赢×回收率) − 误伤成本(好客净贡献×流失系数)，口径见 @sec-econ。
if (need_data(D$bt_panel, "策略回测", COLS_BT)) guard({
  p <- prep_bt(D$bt_panel)
  folds <- purged_folds(p$bet_date)
  pfp <- .hash(list(nrow(p), names(p), .fp_input(p)))
  res <- cached("bt_folds", version = "v1",
    inputs = list(p), params = list(q_thr = 0.99, recover = 0.60, churn = 0.15,
                                    train = BT_PARAMS$train, embargo = BT_PARAMS$embargo,
                                    test = BT_PARAMS$test, step = BT_PARAMS$step,
                                    mode = BT_PARAMS$mode),
    expr = map_dfr_pg(folds, function(f) fold_ckpt(p, f, pfp), label = "策略回测逐折"))
  if (!nrow(res)) {
    tibble::tibble(状态 = "无有效折") |>
      aurora_kb(caption = paste0("业绩增幅（无有效折）",
        "｜解释：面板时间跨度不足以切出完整折",
        "｜本方案用途：说明增幅暂不可估，而非估为零"))
  } else {
    te_lo <- min(res$测试止日, na.rm = TRUE) - BT_PARAMS$test + 1
    te_hi <- max(res$测试止日, na.rm = TRUE)
    win <- p[p$bet_date >= te_lo & p$bet_date <= te_hi, , drop = FALSE]
    stake <- sum(suppressWarnings(as.numeric(win$stake)), na.rm = TRUE)
    ggr   <- -sum(suppressWarnings(as.numeric(win$game_pnl)), na.rm = TRUE)
    gain  <- sum(res$净增益, na.rm = TRUE)
    tibble::tibble(
      项目 = c("覆盖测试期", "覆盖折数", "同期总投注", "同期 GGR",
               "赏罚净增益合计", "占同期 GGR 比重", "占同期投注比重",
               "折均净增益", "净增益为正的折占比"),
      数值 = c(glue::glue("{te_lo} ~ {te_hi}"),
               as.character(nrow(res)),
               format(round(stake, 0), big.mark = ","),
               format(round(ggr, 0), big.mark = ","),
               format(round(gain, 0), big.mark = ","),
               scales::percent(gain / max(ggr, 1e-9), accuracy = .01),
               scales::percent(gain / max(stake, 1e-9), accuracy = .001),
               format(round(mean(res$净增益, na.rm = TRUE), 0), big.mark = ","),
               scales::percent(mean(res$净增益 > 0, na.rm = TRUE), accuracy = .1))) |>
      aurora_kb(caption = paste0(
        "赏罚制度的业绩增幅（回测测试期合计，本次渲染现算）",
        "｜解释：净增益为「从该罚者手上收回的部分」减去「误伤好客造成的流失损失」，",
        "再与同期博彩毛收入与投注额相比",
        "｜本方案用途：回答「这套赏罚一个季度能多赚多少」，并作为上线与否的经济门槛"))
  }
}, "策略回测") else ph_out("策略回测")
```

## 赏罚幅度与上限：从综合分到具体金额 {#sec-roster-amount}

分档只回答「谁该赏、谁该罚」，不回答「赏多少、罚多少」。幅度一律由**两段式**给出：
先把综合分折成 $[0,1]$ 的强度，再乘以该实体各自的上限。

**强度**（$S_i$ 为对象 $i$ 的综合分，$q_{95},q_{05}$ 为该实体本次现算的分档线）：

$$u^{+}_i=\frac{S_i-q_{95}}{S_{\max}-q_{95}},\qquad
u^{-}_i=\frac{q_{05}-S_i}{q_{05}-S_{\min}},\qquad u^{\pm}_i\in[0,1]$$

**幅度**（$\gamma^{*},\delta^{*}$ 为该实体的上限，推导见 @sec-econ）：

$$\gamma_i=\gamma^{*}\cdot u^{+}_i,\qquad \delta_i=\delta^{*}\cdot u^{-}_i$$

**上限按实体分两类**——

- **玩家与代理**：上限即 @sec-econ 的 $\gamma^{*},\delta^{*}$，以**退水率的百分点**计，
  硬天花板为 $\gamma^{*}\le m-\rho-\kappa$（净贡献率为负者一分不赏）。
- **荷官与风控专员**：二者是雇员，不走退水。奖金池按回测实测净增益分成，
  个人上限按强度在池内分配：

$$\text{池}_e=\Big(\sum_f \text{净增益}_f\Big)\times s_e,\qquad
\text{奖金}_i=\text{池}_e\cdot\frac{u^{+}_i}{\sum_j u^{+}_j}$$

其中分成比例 $s_e$ 是**外生常数**（与回收率 0.60、流失系数 0.15 同类），
本方案取荷官 $s=0.02$、风控专员 $s=0.03$——风控专员分成略高，因其产出
直接对应命中与复核，而荷官的贡献中相当部分来自排班而非个人。
罚侧对雇员不作扣款，只作**绩效档位下调**，等效幅度以奖金归零为下界。

**逐维赏罚**：综合分只给出一个总量，说不清「这一分是哪一维挣来的、哪一维扣掉的」。
故幅度按维度分摊——对实体 $e$ 的对象 $i$，取其在维度 $d$ 上的分位值
$N_{i,d}\in[0,100]$（与雷达同一套分位归一），该维本次现算的分档线为
$q^{d}_{95},q^{d}_{05}$：

$$u^{+}_{i,d}=\frac{\max(N_{i,d}-q^{d}_{95},0)}{100-q^{d}_{95}},\qquad
u^{-}_{i,d}=\frac{\max(q^{d}_{05}-N_{i,d},0)}{q^{d}_{05}}$$

$$\gamma_i=\gamma^{*}\sum_{d\in D^{+}_e} w_d\,u^{+}_{i,d},\qquad
\delta_i=\delta^{*}\sum_{d\in D^{-}_e} w_d\,u^{-}_{i,d},\qquad
\sum_{d} w_d=1$$

权重 $w_d$ 在同向维度间等分（$w_d=1/|D^{\pm}_e|$）——维度谁轻谁重尚无历史数据可校准，
等权是唯一不掺主观的取法；日后有了申诉与追认记录，再按各维的预测力重估。
因 $u\in[0,1]$ 且 $\sum w_d=1$，故恒有 $\gamma_i\le\gamma^{*}$、$\delta_i\le\delta^{*}$——
**逐维分摊不会突破上限**，这是把上限写成乘法式的原因。

```{r}
#| label: roster-dim-amounts
#| echo: false
## 逐维赏罚：维度清单与方向取自 @sec-radar 本次实际用上的维度（非静态清单），
## 分位与分档线按各维现算，幅度按等权分摊后乘以该实体上限。
ED <- tryCatch(reticulate::py$ENT_DIMS, error = function(e) NULL)
if (!length(ROSTER) || !length(ED)) {
  tibble::tibble(状态 = "⬜ 待数据",
    所待文件 = "数据库/_scored_{实体}.csv 与 @sec-radar 的维度方向表（同一渲染内产生）",
    受影响输出 = "逐维赏罚幅度全部结果") |>
    aurora_kb(caption = paste0("逐维赏罚幅度（待评分件）",
      "｜解释：按每一个评分维度分别算强度，再等权合成为赏罚幅度",
      "｜本方案用途：让每一分赏罚都能追到具体维度，便于向被罚对象说明理由"))
} else {
  dimtab <- dplyr::bind_rows(lapply(ED, function(x) tibble::as_tibble(lapply(x, as.character))))
  pctn <- function(v) {
    v <- suppressWarnings(as.numeric(v))
    if (all(is.na(v))) return(rep(NA_real_, length(v)))
    100 * stats::ecdf(v[is.finite(v)])(v)
  }
  out <- dplyr::bind_rows(lapply(ROSTER, function(z) {
    if (!z$分档) return(NULL)                 # 未分档实体不参与逐维幅度
    e <- z$实体; x <- z$tab
    dd <- dimtab[dimtab$实体 == e, , drop = FALSE]
    dd <- dd[dd$维度 %in% names(x), , drop = FALSE]
    if (!nrow(dd)) return(NULL)
    npos <- sum(dd$方向 == "赏"); nneg <- sum(dd$方向 == "罚")
    dplyr::bind_rows(lapply(seq_len(nrow(dd)), function(k) {
      d <- dd$维度[k]; dir <- dd$方向[k]
      N <- pctn(x[[d]])
      q95 <- stats::quantile(N, .95, na.rm = TRUE)
      q05 <- stats::quantile(N, .05, na.rm = TRUE)
      if (dir == "赏") {
        u <- pmax(N - q95, 0) / max(100 - q95, 1e-9)
        w <- if (npos > 0) 1 / npos else 0
        tibble::tibble(实体 = e, 维度 = d, 方向 = dir,
          `分档线（分位）` = round(q95, 1), 权重 = round(w, 4),
          触发人数 = sum(u > 0, na.rm = TRUE),
          `触发者平均强度` = round(mean(u[u > 0], na.rm = TRUE), 3),
          `该维对幅度的最大贡献` = scales::percent(w * 1, accuracy = .1))
      } else {
        u <- pmax(q05 - N, 0) / max(q05, 1e-9)
        w <- if (nneg > 0) 1 / nneg else 0
        tibble::tibble(实体 = e, 维度 = d, 方向 = dir,
          `分档线（分位）` = round(q05, 1), 权重 = round(w, 4),
          触发人数 = sum(u > 0, na.rm = TRUE),
          `触发者平均强度` = round(mean(u[u > 0], na.rm = TRUE), 3),
          `该维对幅度的最大贡献` = scales::percent(w * 1, accuracy = .1))
      }
    }))
  }))
  if (is.null(out) || !nrow(out)) {
    tibble::tibble(状态 = "⬜ 维度列未落入评分件",
      说明 = "评分件缺维度原值列，无法逐维计算；补列办法见 SQL 总包 S-01ex / S-02ex / S-03ex / §S04p") |>
      aurora_kb(caption = paste0("逐维赏罚幅度",
        "｜解释：需评分件保留各维原值方能逐维现算",
        "｜本方案用途：补列后即可逐维追责与逐维奖励"))
  } else {
    out |> aurora_dt(caption = paste0(
      "逐维赏罚幅度参数（各维分档线、权重、触发人数与平均强度，本次渲染现算）",
      "｜解释：分档线是该维分位值的 P95（赏）或 P5（罚）；权重为同向维度等分；",
      "「该维对幅度的最大贡献」指某人在该维做到极致时，能占满上限的百分之几",
      "｜本方案用途：把一笔赏罚拆到维度上——对被罚者可逐条出示是哪几维越线、",
      "各占多少，对被赏者可说明奖励来自哪几项贡献"), len = 15)
  }
}
```

```{r}
#| label: roster-amounts
#| echo: false
## 幅度参数一律现算：分档线与极值取自评分件，上限取自 @sec-econ 的赏罚引擎
## （玩家、代理走退水口径）与本次回测净增益（荷官、风控专员走奖金池口径）。
BONUS_SHARE <- c(荷官 = 0.02, 风控专员 = 0.03)   # 外生常数，与回收率/流失系数同类
if (!length(ROSTER)) {
  tibble::tibble(状态 = "⬜ 待数据",
    所待文件 = "数据库/_scored_玩家.csv 等四份（由 @sec-radar 写出）",
    受影响输出 = "赏罚幅度与上限全部参数") |>
    aurora_kb(caption = paste0("赏罚幅度参数（待评分件）",
      "｜解释：幅度＝强度×上限，两者皆须评分件到位才算得出",
      "｜本方案用途：评分件到位后自动给出每类对象的赏罚幅度区间"))
} else {
  ## ① 玩家/代理侧上限：复用赏罚引擎，对分群结果按洗码量加权
  cap_rebate <- guard({
    if (need_data(D$seg_econ, "赏罚经济", COLS_SEG)) {
      sg <- D$seg_econ |> dplyr::mutate(dplyr::across(
        dplyr::any_of(c("validbet","ggr","rebate","commission","n_member","tenure_months")),
        ~suppressWarnings(as.numeric(.x))))
      if (!"tenure_months" %in% names(sg)) sg$tenure_months <- 6
      o <- lapply(seq_len(nrow(sg)), function(i) {
        V <- sg$validbet[i]; G <- sg$ggr[i]; R <- sg$rebate[i]; K <- sg$commission[i]
        policy_cap(m = G / max(V, 1e-9), rho = R / max(V, 1e-9),
                   kappa = K / max(V, 1e-9), V = V, H = max(sg$tenure_months[i], 1))
      })
      w <- sg$validbet / max(sum(sg$validbet, na.rm = TRUE), 1e-9)
      list(gam = sum(vapply(o, function(x) x$gamma_star, numeric(1)) * w, na.rm = TRUE),
           del = sum(vapply(o, function(x) x$delta_star, numeric(1)) * w, na.rm = TRUE))
    } else NULL
  }, "赏罚经济")
  ## ② 雇员侧奖金池：取本次回测逐折净增益合计
  pool_base <- guard({
    if (need_data(D$bt_panel, "策略回测", COLS_BT)) {
      p2 <- prep_bt(D$bt_panel)
      r2 <- cached("bt_folds", version = "v1",
        inputs = list(p2), params = list(q_thr = 0.99, recover = 0.60, churn = 0.15,
                        train = BT_PARAMS$train, embargo = BT_PARAMS$embargo,
                        test = BT_PARAMS$test, step = BT_PARAMS$step, mode = BT_PARAMS$mode),
        expr = map_dfr_pg(purged_folds(p2$bet_date),
                          function(f) fold_ckpt(p2, f,
                            .hash(list(nrow(p2), names(p2), .fp_input(p2)))),
                          label = "策略回测逐折"))
      if (nrow(r2)) sum(r2$净增益, na.rm = TRUE) else NA_real_
    } else NA_real_
  }, "策略回测")

  dplyr::bind_rows(lapply(ROSTER, function(z) {
    x <- z$tab; e <- z$实体
    if (!z$分档) return(tibble::tibble(
      实体 = e, 口径 = "不适用（在册人数不足，未分档）",
      赏的上限 = "—", 单人赏上限 = "—", 罚的上限 = "—",
      该赏人数 = 0L, 该罚人数 = 0L, 平均赏强度 = NA_real_, 平均罚强度 = NA_real_))
    up <- pmax((x$综合分 - z$hi) / max(max(x$综合分) - z$hi, 1e-9), 0)
    un <- pmax((z$lo - x$综合分) / max(z$lo - min(x$综合分), 1e-9), 0)
    up <- pmin(up, 1); un <- pmin(un, 1)
    is_emp <- e %in% names(BONUS_SHARE)
    if (is_emp) {
      pool <- if (is.na(pool_base)) NA_real_ else pool_base * BONUS_SHARE[[e]]
      su   <- sum(up[x$赏罚 == "该赏"], na.rm = TRUE)
      tibble::tibble(
        实体 = e, 口径 = "奖金池分成（雇员）",
        赏的上限 = if (is.na(pool)) "⬜ 待 B01_bt_panel.csv（SQL 总包 §B01）"
                   else glue::glue("池 {format(round(pool,0), big.mark=',')}（净增益×{BONUS_SHARE[[e]]*100}%）"),
        单人赏上限 = if (is.na(pool) || su <= 0) "—"
                     else format(round(pool * max(up) / su, 0), big.mark = ","),
        罚的上限 = "绩效档位下调，下界为奖金归零（不扣薪）",
        该赏人数 = sum(x$赏罚 == "该赏"), 该罚人数 = sum(x$赏罚 == "该罚"),
        平均赏强度 = round(mean(up[x$赏罚 == "该赏"], na.rm = TRUE), 3),
        平均罚强度 = round(mean(un[x$赏罚 == "该罚"], na.rm = TRUE), 3))
    } else {
      g <- if (is.null(cap_rebate)) NA_real_ else cap_rebate$gam
      d <- if (is.null(cap_rebate)) NA_real_ else cap_rebate$del
      tibble::tibble(
        实体 = e, 口径 = "退水率百分点（客户侧）",
        赏的上限 = if (is.na(g)) "⬜ 待 E02_segment_econ.csv（SQL 总包 §E02c）"
                   else scales::percent(g, accuracy = .001),
        单人赏上限 = if (is.na(g)) "—" else scales::percent(g * max(up), accuracy = .001),
        罚的上限 = if (is.na(d)) "⬜ 待 E02_segment_econ.csv（SQL 总包 §E02c）"
                   else scales::percent(d, accuracy = .001),
        该赏人数 = sum(x$赏罚 == "该赏"), 该罚人数 = sum(x$赏罚 == "该罚"),
        平均赏强度 = round(mean(up[x$赏罚 == "该赏"], na.rm = TRUE), 3),
        平均罚强度 = round(mean(un[x$赏罚 == "该罚"], na.rm = TRUE), 3))
    }
  })) |>
    aurora_kb(caption = paste0(
      "四实体赏罚幅度与上限（强度与人数现算；上限取自赏罚引擎与本次回测净增益）",
      "｜解释：赏罚幅度＝强度×上限；强度由对象自身综合分与该类分档线算出，",
      "上限对客户侧是退水百分点、对雇员侧是奖金池分成",
      "｜本方案用途：把评分直接换算成可执行的返水档位与奖金数额，落到结算单上"))
}
```

::: {.callout-note}
## 名单口径的三条界线

1. **在册人数按评分件行数计**，非全平台会员数；未在本窗口下注者不在评分件内。
2. **分档线随数据走**：该赏取综合分 P95、该罚取 P5，数据一变分档线随之改变，
   不存在写死的门槛。
3. **该罚只启动调查程序**，不等于处分。误伤一名好客所赔的是其终身价值，
   故名录一律配合 @sec-plan 的申诉与复核流程使用。
:::

