## 2.2 玩家流失预测：随机生存森林 + Cox + XGBoost + LightGBM 四模型比较

> V1受限于样本窗口只有9.77天，"30天不活跃算流失"这个业务定义在
> 数学上不可能触发，被迫退回用相对分位数(recency的P75)当替代定义。
> **V2这次窗口有135天，远超过30天，可以直接用原本的业务定义，
> 不需要再退而求其次**——这是V2另一处相对V1的结构性进步。

```{r 随机森林}
玩家特征路径 <- file.path(秦直道, '玩家特征.csv')

if (file.exists(玩家特征路径)) {
  玩家特征 <- fread(玩家特征路径)
} else {
  玩家特征 <- global_data[, .(
  first_date = min(dt), last_date = max(dt),
  total_bets = sum(total_bets), avg_bet = mean(avg_bet, na.rm=TRUE),
  std_bet = sd(avg_bet, na.rm=TRUE), total_turnover = sum(total_bet_amount),
  total_win = sum(total_win_amount), total_ggr = sum(ggr),
  win_rate = sum(total_win_amount) / pmax(sum(total_bet_amount), 1e-9),
  unique_games = uniqueN(game_type), unique_dealers = uniqueN(dealer_id[dealer_id!=-1]),
  unique_tables = uniqueN(table_id), active_days = uniqueN(dt)
  ), by = player_id]
  玩家特征[is.na(std_bet), std_bet := 0]
  玩家特征[, duration_days := as.numeric(last_date - first_date) + 1]
  
  观察窗口结束日 <- max(global_data$dt)
  玩家特征[, event := as.integer((观察窗口结束日 - last_date) > 30)]
  fwrite(玩家特征, 玩家特征路径)
}

# ============================================================
# 【本次校对新增：先诚实看清楚真实分布，不假设】
# 此前报错"cannot allocate vector of size 784.0 Mb"的诊断建议中
# 特别强调"务必先跑这三行"——这里补成正式代码，不是跑一次就丢掉，
# 而是每次渲染都会印出来，方便随时核对分布是否随数据更新而改变。
# ============================================================
cat("=== event分布(真实数字) ===\n")
print(table(玩家特征$event, useNA = "ifany"))
cat(sprintf("event=1(流失)占比: %.2f%%　|　event=0(仍活跃/被截断)占比: %.2f%%\n",
    mean(玩家特征$event)*100, mean(1-玩家特征$event)*100))

cat("\n=== duration_days分布 ===\n")
print(summary(玩家特征$duration_days))
print(quantile(玩家特征$duration_days, probs=c(0,.01,.05,.25,.5,.75,.95,.99,1), na.rm=TRUE))

# 【诚实说明这个分布的业务含义】中位数若落在1-2天附近，代表超过一半
# 玩家只出现1-2天就再也没回来——这批"一次性玩家"跟"活跃过一阵子才
# 流失的玩家"，在生存分析的意义上其实是两种不同的人群，本报告仍
# 把两者放在同一个模型里处理(与需求一致，重点是让模型能训练成功)，
# 但业务解读时应该留意：模型抓到的"流失风险"，很大一部分权重可能
# 来自这批一次性玩家的极短存续期，而非真正"原本活跃、后来流失"
# 这种更有业务行动价值的模式。

# ============================================================
# 【本次校对：采纳"只保留9个RSF需要的字段"这条关键建议，并按下游
# 实际依赖扩充到11个】——原写法complete.cases()只检查了6个栏位，
# 但公式里用到unique_dealers、duration_days、event都没被检查，
# 且rsf_data仍带着玩家特征的全部栏位(first_date/last_date/total_win/
# total_ggr/active_days等完全没被RSF公式用到)，随后as.data.frame()
# 又整份复制一次——这正是1,027,618名玩家规模下把内存推爆的关键
# 浪费点。这里只留真正需要的栏位：9个建模用(公式7个predictor+
# duration_days+event)，另外2个(player_id、total_bets)是5.2节
# Uplift Modeling下游需要、必须保留。
# ============================================================
rsf_vars <- c("player_id", "duration_days", "event",
              "avg_bet", "std_bet", "win_rate", "total_turnover",
              "unique_games", "unique_tables", "unique_dealers", "total_bets")
rsf_data <- 玩家特征[complete.cases(玩家特征[, ..rsf_vars]), ..rsf_vars]
cat(sprintf("\nRSF有效玩家数(11栏位、且7个建模变量+duration_days+event均无缺失): %s\n",
    format(nrow(rsf_data), big.mark=",")))
print(object.size(rsf_data), units = "auto")

公式 <- Surv(duration_days, event) ~ avg_bet + std_bet + win_rate + total_turnover + unique_games + unique_tables + unique_dealers

# ============================================================
# 【本次校对：采纳"分层抽样训练+全量预测"架构，但用真实数据校正
# 分层比例】——诊断建议假设event=1是少数类(举例7,618/1,027,618)，
# 但实测真实数据是event=1占73.06%、反而是多数类，event=0(仍活跃)
# 才是26.94%的少数类。分层抽样真正该保证的是"少数类(event=0)有
# 足够代表性"，而不是像诊断建议那样人为把少数类"拉高到30%"——
# 若真的照搬那个假设性比例，会在方向搞反的情况下，人为压低本来
# 就占多数的event=1比例，扭曲训练集的真实分布。这里改成：训练集
# 维持接近真实总体比例，只确保少数类(event=0)绝对数量足够(至少
# 3万筆，通常足以支撑树模型稳定训练)。
# ============================================================
计数栈道 <- file.path(qmd_所在目录, "卷房")
if (!dir.exists(计数栈道)) dir.create(计数栈道)
rsf缓存路径 <- file.path(计数栈道, "随机森林尤物_报告V2.rds")

最大ntree候选  <- 200

if (file.exists(rsf缓存路径)) {
  随机森林尤物 <- readRDS(rsf缓存路径)
  rsf_train <- readRDS(file.path(计数栈道, "随机森林训练子集_报告V2.rds"))
  cat("已从缓存读取RSF模型与对应训练子集。\n")
} else {
  set.seed(20260803)
  n_train_目标 <- 200000
  idx_event0 <- which(rsf_data$event == 0)  # 真正的少数类：仍活跃/被截断
  idx_event1 <- which(rsf_data$event == 1)  # 真正的多数类：已流失

  n_event0 <- length(idx_event0)  # 少数类全部保留(反正26.94%×20万约5.4万，本身就在训练集里)
  n_event1 <- n_train_目标 - n_event0
  # train_idx <- c(idx_event0, sample(idx_event1, min(n_event1, length(idx_event1))))
  train_idx <- c(
  sample(idx_event0, min(length(idx_event0), 30000)),
  sample(idx_event1, min(length(idx_event1), 170000))
  )
  rsf_train <- rsf_data[train_idx]
  cat(sprintf("训练子集: %s名玩家(全部%s名event=0少数类 + 随机抽样%s名event=1)\n",
      format(nrow(rsf_train), big.mark=","), format(n_event0, big.mark=","),
      format(nrow(rsf_train)-n_event0, big.mark=",")))
  cat("训练子集event分布:\n"); print(table(rsf_train$event))

  # 先用小规模测试参数确认森林能正常生长(诊断建议③④⑤条)，
  # importance=FALSE降低训练期间的额外内存压力，nodesize放大到50
  # (百万级规模下nodesize=15太激进，容易长出过深的树、大幅推高内存)
  随机森林尤物 <- 计时执行(function() {
    rfsrc(
      公式, data = rsf_train,
      ntree = 最大ntree候选,
      forest = TRUE, importance = TRUE,
      splitrule = "logrank", seed = 42,
      nodesize = 400,  # 【本次调整】从30调到300——终端节点最小样本数变大，
                   # 逼着每棵树分裂更少次、留下更少但更大的终端节点，
                   # 需要存的生存曲线数量跟着变少，是比membership更直接
                   # 命中体积大头的参数；副作用是模型灵活度会降低一些，
                   # 建议改完后对比一下Brier Score有没有明显变差，
                   # 不要为了缩文件牺牲太多精度
      membership = FALSE  # 【本次校对新增】最大的体积来源——默认会存一份
                          # N名玩家×500棵树的终端节点归属矩阵，本文档后续
