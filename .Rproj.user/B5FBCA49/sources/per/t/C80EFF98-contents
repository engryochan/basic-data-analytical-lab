## 3.0c 团伙合谋侦测：图论方法（V1套件清单已备但从未真正实现，本次首次落地）

> V1的套件清单里装了`igraph`，但V1全文从未真正用它做过任何分析——
> 这是本次系统性核对V1全部维度与工具时发现的落差，这里正式补上。
> 方法论衔接《异常IP与尾秒下注风控》报告已经验证过的disparity
> filter+FDR统计校正原则：**同一天出现在同一荷官/同一桌台的玩家
> 组合太多，光靠"共同出现次数超过某个固定门槛"这种阈值，几乎必然
> 重演V1报告"关联≥20且盈利比例≥90%命中0个"的教训**——命中数字
> 要经过统计校正后才可信，不能直接用人工设定的固定门槛。

```{r 图论方法}
# 建立"玩家-玩家"共同出现网络：同一天、同一荷官、同一桌台都出现过的
# 玩家配对，权重是共同出现的天数
共现明细 <- 真人荷官注单[, .(玩家清单 = list(unique(player_id))), by = .(dt, dealer_id, table_id)]
共现明细 <- 共现明细[lengths(玩家清单) >= 2 & lengths(玩家清单) <= 12]  # 单人不算共现；人数太多(>12)的桌台多半是电子化多台面共享荷官，噪声大于信号，先排除

配对边 <- rbindlist(lapply(共现明细$玩家清单, function(v) {
  if (length(v) > 12) return(NULL)
  as.data.table(t(combn(sort(v), 2)))
}))
setnames(配对边, c("V1","V2"))
边权重 <- 配对边[, .(共现天数 = .N), by = .(V1, V2)]
cat(sprintf("共现网络：%s条边(玩家配对)，%s个不重复配对\n",
    format(nrow(配对边), big.mark=","), format(nrow(边权重), big.mark=",")))

# 只保留共现天数达统计意义门槛的边(单次共现太容易是巧合，不建边)
候选边 <- 边权重[共现天数 >= 3]
cat(sprintf("共现≥3天的候选边: %s条\n", format(nrow(候选边), big.mark=",")))

if (nrow(候选边) > 0) {
  # ---- 建图 + 连通分量 ----
  网络图 <- graph_from_data_frame(候选边[, .(V1,V2,weight=共现天数)], directed = FALSE)
  连通分量 <- components(网络图)
  cat(sprintf("\n连通分量数: %d　最大连通分量玩家数: %d\n",
      连通分量$no, max(连通分量$csize)))

  # ---- Louvain社区发现：找出网络内部结构性更紧密的子团体 ----
  louvain结果 <- cluster_louvain(网络图)
  cat(sprintf("Louvain社区数: %d　模块度(modularity): %.3f\n",
      length(unique(membership(louvain结果))), modularity(louvain结果)))

  社区规模 <- as.data.table(table(membership(louvain结果)))
  setnames(社区规模, c("社区","人数"))
  社区规模[, 人数 := as.integer(人数)]
  cat("\n=== 规模最大的10个社区 ===\n")
  print(社区规模[order(-人数)][1:min(10,.N)])

  # ---- 统计校正：不能直接说"社区大就可疑"，要检验社区内部玩家的
  # 盈利表现是否统计上显著偏离全平台基准，衔接《异常IP》报告方法论 ----
  平台基准盈利率 <- mean(玩家特征$净盈利 > 0, na.rm=TRUE)
  社区成员表 <- data.table(player_id = as.integer(names(membership(louvain结果))),
                            社区 = as.integer(membership(louvain结果)))
  社区成员表 <- merge(社区成员表, 玩家特征[, .(player_id, 净盈利)], by="player_id")
  社区检验候选 <- 社区成员表[, .(人数=.N, 盈利人数=sum(净盈利>0)), by=社区][人数>=5]
  if (nrow(社区检验候选) > 0) {
    社区检验候选[, p值 := purrr::pmap_dbl(list(盈利人数, 人数), function(k,n)
      binom.test(k, n, p=平台基准盈利率, alternative="greater")$p.value)]
    社区检验候选[, p值_FDR := p.adjust(p值, method="BH")]
    社区检验候选[, 统计显著 := p值_FDR < 0.01]
    cat(sprintf("\n候选社区数(人数≥5): %d　FDR校正后统计显著: %d\n",
        nrow(社区检验候选), sum(社区检验候选$统计显著)))
    if (sum(社区检验候选$统计显著) > 0) {
      cat("=== 统计显著的可疑社区 ===\n")
      print(社区检验候选[统计显著==TRUE][order(-人数)])
    }
  }
} else {
  message("ℹ️ 没有达到共现门槛的候选边，本节无法继续。")
}
```

