setorder(日度_特征化, 日)
for (lag in 1:7) 日度_特征化[, paste0("lag",lag) := shift(总GGR, lag)]
日度_特征化 <- 日度_特征化[complete.cases(日度_特征化[, paste0("lag",1:7), with=FALSE])]
切分点 <- floor(nrow(日度_特征化)*0.8)
lgb_lag模型 <- tryCatch({
  lgb.train(params=list(objective="regression", verbosity=-1),
    data = lgb.Dataset(as.matrix(日度_特征化[1:切分点, paste0("lag",1:7), with=FALSE]),
                        label=日度_特征化$总GGR[1:切分点]), nrounds=100)
}, error = function(e) NULL)
if (!is.null(lgb_lag模型) && 切分点 < nrow(日度_特征化)) {
