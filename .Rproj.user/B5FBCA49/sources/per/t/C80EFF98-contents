## 读取数据

> **数据规模先说清楚**：这次是真实全局数据，不是抽样——服务端按
> "玩家×日×游戏类型×荷官×桌台"五维聚合后，原始导出277个批次文件
> (每批10万行，最后一批87,918行零头，是导出期间源数据库持续增长
> 产生的自然尾数，不是错误)，合计27,687,918行。**经过完整性核对，
> 发现36.49%的行是重复的**(1,020万行)——根源是聚合SQL的分页
> (`LIMIT/OFFSET`)当初没有明确的`ORDER BY`，不稳定排序导致批次间
> 重叠，这跟本方案另一份《异常IP与尾秒下注风控》报告踩过的坑
> (36.8%重复率)是同一类问题，几乎相同的比例并非巧合，是同一种
> SQL写法带来的系统性风险。**真实、去重后的行数是17,583,839**，
> 已完成核对：涉及102.76万名不重复玩家、306个荷官、31个桌台、
> 8种游戏类型，时间跨度2026-03-21至2026-08-02(135天)。

```{r 连接可用}
#| eval: FALSE
# ============================================================
# 数据获取：if/else双路径，收口成同一套栏位结构——沿用《异常IP与
# 尾秒下注风控》报告验证过的架构模式，这次额外加上本地路径的
# 去重检查(上面说明已经确认过36.49%的重复率，不能假设本地文件
# 是干净的)。
# ============================================================

if (连接可用) {
  # ---- 路径A：live连线，直接在StarRocks端聚合查询 ----
  # 【重要】相比原始探索用的SQL模板，这里补上了ORDER BY——没有
  # ORDER BY的LIMIT/OFFSET分页，在数据持续写入的生产库上不保证
  # 稳定顺序，这正是本地277批文件出现36.49%重复率的根源。补上
  # ORDER BY后，若未来需要重新导出批次文件，就不会重蹈覆辙。
  cat("✅ 侦测到数据库连线，走live查询路径。\n")
  日度聚合 <- as.data.table(计时执行(function() {
    DBI::dbGetQuery(con, "
      SELECT
          dt, bet05 AS player_id, bet02 AS game_type, eid AS dealer_id, bet39 AS table_id,
          COUNT(*) AS total_bets,
          SUM(CAST(bet13 AS DECIMAL(20,4))) AS total_bet_amount,
          SUM(CAST(bet14 AS DECIMAL(20,4))) AS total_win_amount,
          SUM(CAST(bet13 AS DECIMAL(20,4)) - CAST(bet14 AS DECIMAL(20,4))) AS ggr,
          AVG(CAST(bet13 AS DECIMAL(20,4))) AS avg_bet,
          MIN(bet08) AS first_bet_time,
          MAX(bet08) AS last_bet_time,
          COUNT(DISTINCT bet01) AS unique_rounds
      FROM ods_mariadb_2b.ods_a168_bet02
      WHERE dt BETWEEN '2024-01-01' AND CURRENT_DATE()
      GROUP BY dt, bet05, bet02, eid, bet39
      ORDER BY dt, player_id, game_type, dealer_id, table_id
    ")
  }, "服务端聚合·玩家日度多维度指标", 预估提示 = "1.85亿行原始明细做GROUP BY聚合，StarRocks列式引擎通常是分钟级"))

} else {
  # ---- 路径B：无连线，读本机已下载的276+批聚合CSV ----
  cat("ℹ️ 未侦测到数据库连线，走本地批次CSV路径。\n")

  # 【本次校对：实测发现zip套件在这台机器上也不可靠，非纯粹方法论猜测】
  # 原本认为zip套件的unzip()对Unicode档名处理比base R稳健，实测后
  # 发现并非如此——这台Windows机器上zip::unzip()解压7个压缩包，
  # 3个直接报"Failed to set mtime"，另外4个即使没报错，写出来的
  # 档名也被搞乱了。**后来用户改用Windows内建"全部解压缩"手动解压，
  # 档名依然乱码**——这confirmed问题出在zip压缩包打包当下的编码方式
  # 本身(很可能用了不支持UTF-8旗标的传统zip编码，压进档名的中文
  # 字节，任何解压工具用系统locale去反解都对不上)，不是哪个解压
  # 工具的问题，没有任何解压方式能救回正确档名。
  #
  # 【本次校对：不再跟档名较劲，改成"不管档名是什么，只要是csv就读"】
  # 档名本身除了给人看之外，对后续分析没有任何功能性用途——真正决定
  # "这一行是不是重复"的是内容栏位(dt,player_id,game_type,dealer_id,
  # table_id)的组合，不是档名或读取顺序。既然档名救不回来，就不再
  # 假设档名符合"玩家每日投注数据_日计_第N批.csv"这个格式，改成
  # 广泛搜寻'数据库/'资料夹(含子资料夹)下所有.csv档，不管叫什么名字
  # 都读进来。
  压缩包子资料夹 <- file.path(秦直道, "玩家每日投注数据_日计")
  批次压缩文件清单 <- list.files(
    path = 压缩包子资料夹, pattern = "\\.zip$", full.names = TRUE
  )
  if (length(批次压缩文件清单) > 0) {
    cat(sprintf("侦测到 %d 个本地zip压缩包，尝试自动解压(不保证档名正确，", length(批次压缩文件清单)))
    cat("下方改用'只要是csv就读'的方式处理，不依赖档名)...\n")
    for (压缩包 in 批次压缩文件清单) {
      tryCatch({
        zip::unzip(压缩包, exdir = 压缩包子资料夹)
      }, error = function(e) {
        message(sprintf("⚠️ 解压'%s'失败：%s(若之前已用Windows内建方式手动解压过，", basename(压缩包), conditionMessage(e)))
        message("   这个失败可以忽略，下方会直接找已经解压好的csv)")
      })
    }
  }

  # 广泛搜寻：不管档名长什么样(含乱码)，只要副档名是.csv、且不在
  # 已经处理过的输出路径里，就当作这次要读的批次文件——同时搜"数据库/"
  # 根目录跟"数据库/玩家每日投注数据_日计/"子资料夹两个位置，因为
  # 手动解压时使用者可能选了任一个当解压目的地。
  批次文件清单 <- list.files(
    path = c(file.path(qmd_所在目录, "数据库"), 压缩包子资料夹),
    pattern = "\\.csv$", full.names = TRUE, recursive = FALSE
  )
  批次文件清单 <- unique(批次文件清单)  # 两个搜寻路径若有重叠(比如子资料夹本身也在根目录搜寻范围内)，去掉重复路径
  if (length(批次文件清单) == 0) {
    stop(paste0(
      "'数据库/'资料夹(含子资料夹)里找不到任何.csv文件。\n",
      "请确认：(a) 已经用Windows内建'全部解压缩'或7-Zip，把7个zip档",
      "解压到'数据库/'资料夹或其'玩家每日投注数据_日计/'子资料夹；\n",
      "(b) 解压出来的确实是.csv文件(不是被压缩包工具误判成其他格式)。\n",
      "档名本身乱码没关系，本节不依赖档名，只要副档名是.csv就会被读取。"
    ))
  }
  cat(sprintf("侦测到 %d 个csv文件(档名可能乱码，不影响读取，内容本身是UTF-8编码的正常数据)\n",
      length(批次文件清单)))

  日度聚合_原始 <- rbindlist(lapply(批次文件清单, fread, encoding = "UTF-8"))
  原始行数 <- nrow(日度聚合_原始)
  cat(sprintf("合并后总行数 = %s\n", format(原始行数, big.mark=",")))

  # 【已微修】CSV读进R的内存后，这份磁盘上的解压副本就没用了(压缩包
  # 本身还留着，需要时随时能重新解压)——读完立刻删除，只保留压缩包，
  # 避免CSV+ZIP两份同时占用磁盘空间(这批数据csv版本约1.7GB以上)。
  # 用tryCatch包一层，就算删除失败(比如档案被其他程序锁住)也只是
  # 提醒一下，不会让整份文档渲染中断。
  if (length(批次压缩文件清单) > 0) {  # 只有"这次是从zip自动解压出来的"才删除；
                                        # 若原本就是使用者自己手动放的csv(没有对应zip)，不动它
    删除结果 <- tryCatch({
      file.remove(批次文件清单)
    }, error = function(e) {
      message("⚠️ 清理解压出来的CSV时发生错误：", conditionMessage(e))
      rep(FALSE, length(批次文件清单))
    })
    cat(sprintf("已清理解压产生的CSV文件：成功删除%d/%d个，只保留原始压缩包。\n",
        sum(删除结果), length(批次文件清单)))
  }

  # 完整性核对：去重前后行数对比，跟上面说明框的数字(27,687,918 -> 17,583,839)对照
  重复数 <- sum(duplicated(日度聚合_原始[, .(dt, player_id, game_type, dealer_id, table_id)]))
  cat(sprintf("本地%d个csv合并后行数 = %s，重复(dt,player_id,game_type,dealer_id,table_id)组合数 = %s (%.2f%%)\n",
      length(批次文件清单), format(原始行数, big.mark=","), format(重复数, big.mark=","), 重复数/原始行数*100))

  日度聚合 <- unique(日度聚合_原始, by = c("dt","player_id","game_type","dealer_id","table_id"))
  rm(日度聚合_原始); gc()  # 及时释放去重前的大对象，17.58M行级别的数据不留无用副本占内存

  cat(sprintf("去重后行数 = %s\n", format(nrow(日度聚合), big.mark=",")))
  stopifnot(
    "去重后行数与已知标准答案(17,583,839)不一致，请确认批次文件是否完整" =
      nrow(日度聚合) == 17583839
  )
  cat("✅ 去重后行数与标准答案完全吻合。\n")
}

cat(sprintf("\n本次实际使用的日度聚合数据：%s 行，%s 名玩家，%s 个荷官，%s 个桌台，%s 种游戏类型，%s 天\n",
    format(nrow(日度聚合), big.mark=","), format(uniqueN(日度聚合$player_id), big.mark=","),
    format(uniqueN(日度聚合$dealer_id), big.mark=","), format(uniqueN(日度聚合$table_id), big.mark=","),
    uniqueN(日度聚合$game_type), uniqueN(日度聚合$dt)))
```

