## 1.7 自动识别数据维度与模型推荐

```{r 模型推荐引擎}
# 沿用V1建立的规则引擎：不用人工一个个数据集去看栏位该配什么模型，
# 自动侦测栏位型态与结构特征，给出对应的模型家族建议
模型推荐引擎 <- function(数据, 名称) {
  cat(sprintf("\n=== %s 的模型推荐(依实际栏位自动判断) ===\n", 名称))
  数值栏位 <- names(数据)[sapply(数据, is.numeric)]
  类别栏位 <- names(数据)[sapply(数据, function(x) is.character(x) || is.factor(x))]
  时间栏位 <- names(数据)[sapply(数据, function(x) inherits(x, c("Date","POSIXct")))]

  高基数类别 <- c()
  for (col in c("player_id","dealer_id","table_id")) {
    if (col %in% names(数据) && uniqueN(数据[[col]]) > 20) 高基数类别 <- c(高基数类别, col)
  }
  if (length(高基数类别) > 0) {
    cat(sprintf("• 侦测到高基数类别栏位(%s，类别数>20) -> 建议用XGBoost/LightGBM/随机森林处理，而非把每个类别都当固定效应硬塞进线性模型；样本量较大时优先考虑LightGBM(直方图算法通常比XGBoost更省时)\n",
        paste(高基数类别, collapse="、")))
  }
  if (length(时间栏位) > 0) {
    cat(sprintf("• 侦测到时间型栏位(%s) -> 适合时间序列预测(ARIMA/ETS)或状态切换侦测(HMM+Regime Kernel)，预测准确度建议用MASE评估\n", paste(时间栏位, collapse="、")))
  }
  if ("player_id" %in% names(数据) && any(duplicated(数据$player_id))) {
    cat("• 侦测到分组栏位「player_id」有重复观测(每组多笔记录) -> 适合阶层贝叶斯模型/lme4/glmmTMB这类多层模型\n")
  }
  if (any(grepl("ggr|roi|profit|盈亏|win", 数值栏位, ignore.case = TRUE))) {
    cat("• 侦测到盈亏/收益/roi类栏位 -> 适合用夏普率/索提诺比率/最大回撤评估这份收益序列稳不稳\n")
  }
}

