# 通用汇总函数：同一套指标口径，不同颗粒度重复调用，避免4处各写一次容易口径不一
汇总函数 <- function(数据, 颗粒度栏位 = NULL) {
  if (is.null(颗粒度栏位)) {
    数据[, .(下注笔数 = sum(total_bets), 独立会员数 = uniqueN(player_id),
             独立荷官数 = uniqueN(dealer_id[dealer_id != -1]), 独立桌台数 = uniqueN(table_id),
             总下注金额 = sum(total_bet_amount), 总派彩金额 = sum(total_win_amount),
             总GGR = sum(ggr), 平均GGR占比 = mean(ggr_rate, na.rm = TRUE))]
  } else {
    数据[, .(下注笔数 = sum(total_bets), 独立会员数 = uniqueN(player_id),
             独立荷官数 = uniqueN(dealer_id[dealer_id != -1]), 独立桌台数 = uniqueN(table_id),
             总下注金额 = sum(total_bet_amount), 总派彩金额 = sum(total_win_amount),
             总GGR = sum(ggr), 平均GGR占比 = mean(ggr_rate, na.rm = TRUE)),
           by = 颗粒度栏位]
  }
}

