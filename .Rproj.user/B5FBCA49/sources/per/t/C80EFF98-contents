## 1.5 全局数据合并（V2版本：字段原生完整，无需V1的代理字段fallback）

> V1报告因为交付的3份CSV是用旧SQL导出、漏选了`bet02 AS game_type`，
> 不得不设计"真实字段存在就用，不存在就退而求其次拿table_id当代理"
> 这套防呆逻辑。**V2这次数据结构从服务端聚合SQL阶段就原生带了
> `game_type`/`dealer_id`/`table_id`三个字段**，不需要重演那套
> fallback——这是V2相对V1的第一个结构性进步：不是"退而求其次的
> 代理"，是"真实字段"。

```{r 全局数据合并}
global_data <- copy(日度聚合)  # 复制一份，避免修改时意外动到原始去重后的数据

# ---- 电投/真人荷官分流(沿用V1同样的判定惯例：dealer_id=-1代表电投) ----
真人荷官注单 <- global_data[dealer_id != -1]
电投注单 <- global_data[dealer_id == -1]
cat(sprintf("真人荷官注单: %s 行 (%.1f%%)　电投注单: %s 行 (%.1f%%)\n",
    format(nrow(真人荷官注单), big.mark=","), nrow(真人荷官注单)/nrow(global_data)*100,
    format(nrow(电投注单), big.mark=","), nrow(电投注单)/nrow(global_data)*100))
cat("第2章'荷官风控'相关模型一律用 真人荷官注单，避免凭空生出一个不存在的'荷官-1'分组污染风险排名。\n")

# ---- 核心衍生列：GGR占投注比、平均单笔金额已经是原生栏位，这里补充
#      需要额外计算的比率型指标 ----
global_data[, ggr_rate := ggr / pmax(total_bet_amount, 1e-9)]  # GGR占投注总额的比例，避免除以0

# ---- win_rate(无前视偏误版本)——沿用V1建立的原则：不能用"当日/全样本
# 胜率"当协变量去预测当日的roi，那是用答案预测答案。这次数据是"日"
# 颗粒度(不是逐局)，"无前视偏误"体现在：只用这一天*之前*的历史日胜率，
# 当天与未来一律不计入。----
setorder(global_data, player_id, dt)
global_data[, `:=`(
  累计派彩_滞后 = shift(cumsum(total_win_amount), 1, fill = 0),
  累计投注_滞后 = shift(cumsum(total_bet_amount), 1, fill = 0)
), by = player_id]
global_data[, win_rate := 累计派彩_滞后 / pmax(累计投注_滞后, 1e-9)]
全局平均胜率兜底值 <- global_data[累计投注_滞后 > 0, mean(win_rate, na.rm = TRUE)]
global_data[is.na(win_rate) | 累计投注_滞后 == 0, win_rate := 全局平均胜率兜底值]  # 玩家第一天(无历史)用全局平均值兜底
cat(sprintf("win_rate(滚动·无前视偏误)已构建，全局平均胜率兜底值=%.3f\n", 全局平均胜率兜底值))

cat(sprintf("\nglobal_data 最终行数: %s　列: %s\n", format(nrow(global_data), big.mark=","), paste(names(global_data), collapse=", ")))
```

