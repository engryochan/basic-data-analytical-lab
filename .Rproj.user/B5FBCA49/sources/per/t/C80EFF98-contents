-- 方案一：最推荐——先在 StarRocks 做「分析宽表」，不要搬 1.85 亿逐笔数据
-- 
-- 您后面真正要分析的是：
-- 
-- 玩家运营
-- 荷官运营
-- 桌台运营
-- 游戏类别
-- 日度
-- 周度
-- 月度
-- 季度
-- 风控
-- 对冲
-- 玩家生命周期
-- 
-- 这些绝大部分根本不需要 1.85 亿笔逐笔记录全部下载到本地。
-- 
-- 例如先做「玩家 × 日」：

SELECT 
    dt,
    bet05 AS player_id,
    bet02 AS game_type,
    eid AS dealer_id,
    bet39 AS table_id,
    
    COUNT(*) AS total_bets,

    SUM(CAST(bet13 AS DECIMAL(20,4))) AS total_bet_amount,

    SUM(CAST(bet14 AS DECIMAL(20,4))) AS total_win_amount,

    SUM(
        CAST(bet13 AS DECIMAL(20,4))
        - CAST(bet14 AS DECIMAL(20,4))
    ) AS ggr,

    AVG(CAST(bet13 AS DECIMAL(20,4))) AS avg_bet,

    MIN(bet08) AS first_bet_time,
    MAX(bet08) AS last_bet_time,

    COUNT(DISTINCT bet01) AS unique_rounds
    FROM ods_mariadb_2b.ods_a168_bet02

    WHERE dt BETWEEN '2024-01-01' AND CURRENT_DATE()

    GROUP BY dt, bet05, bet02, eid, bet39
    ORDER BY dt, bet05, bet02, eid, bet39;  -- 因为是 GROUP BY 的字段，这几个组合必然是唯一的
```

