from pyspark.ml.feature import VectorAssembler, StandardScaler, PCA
from pyspark.ml.clustering import KMeans
from pyspark.ml.evaluation import MulticlassClassificationEvaluator
# 需提前安装：pip install xgboost-spark
from xgboost.spark import SparkXGBClassifier

def run_machine_learning(spark, data_source_path):
    # 1. 读取数据 (假设是 Parquet 格式)
    df = spark.read.parquet(data_source_path)

    # 2. 特征工程：提取数值列组合成向量
    feature_cols = [c for c in df.columns if c not in ['id', 'label']]
    assembler = VectorAssembler(inputCols=feature_cols, outputCol="features_vec")
    df_vec = assembler.transform(df)

    # 3. PCA 降维（尤物：主成分分析）
    pca = PCA(k=10, inputCol="features_vec", outputCol="pca_features")
    pca_model = pca.fit(df_vec)
    df_pca = pca_model.transform(df_vec)
    print("PCA variance explained:", pca_model.explainedVariance) # 输出解释方差

    # 4. K-Means 聚类分析
    kmeans = KMeans(featuresCol="pca_features", k=5)
    kmeans_model = kmeans.fit(df_pca)
    df_cluster = kmeans_model.transform(df_pca)
    print("Clustering Centers:", kmeans_model.clusterCenters())

    # 5. XGBoost 分类（顶级尤物）
    # 注：XGBoost 在 Spark 上需要 vector 列
    xgb = SparkXGBClassifier(
        features_col="pca_features",
        label_col="label",
        max_depth=5,
        n_estimators=100
    )
    # 划分训练测试集
    train, test = df_cluster.randomSplit([0.8, 0.2])
    xgb_model = xgb.fit(train)
    
    # 预测与评估
    predictions = xgb_model.transform(test)
    evaluator = MulticlassClassificationEvaluator(labelCol="label", predictionCol="prediction", metricName="accuracy")
    accuracy = evaluator.evaluate(predictions)
    print(f"XGBoost Accuracy: {accuracy}")
    
